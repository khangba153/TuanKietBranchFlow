@page "/order-menu"

@using TuanKietBranchFlow.Application.DTOs.OrderMenus
@using TuanKietBranchFlow.Application.DTOs.Users
@using TuanKietBranchFlow.Web.Services
@using System.Globalization
@using System.Text
@using TuanKietBranchFlow.Web.Models
@using TuanKietBranchFlow.Application.DTOs.Orders


@inject UserApiService UserApiService
@inject OrderMenuApiService OrderMenuApiService
@inject OrderApiService OrderApiService

<PageTitle>Gọi món</PageTitle>

<section class="bf-page order-menu-page">
    @if (_createOrder is not null)
    {
        <div class="order-menu-success" role="status">
            <span class="order-menu-success-icon" aria-hidden="true">✓</span>

            <div>
                <strong>Tạo đơn thành công</strong>
                <span>
                    Mã @_createOrder.Code ·
                    @_createOrder.TotalAmount.ToString("N0") đ
                </span>
            </div>

            <a class="btn btn-sm btn-light" href="/my-orders">
                Xem đơn
            </a>

            <button type="button" class="btn-close btn-close-white" aria-label="Đóng thông báo"
                    @onclick="() => _createOrder = null">
            </button>
        </div>
    }

    @if (_isLoading)
    {
        <div class="order-menu-state bf-surface-card" role="status" aria-live="polite">
            <span class="spinner-border text-success" aria-hidden="true"></span>
            <strong>Đang chuẩn bị menu</strong>
            <span class="bf-muted">Vui lòng chờ trong giây lát.</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="order-menu-state order-menu-state-error bf-surface-card" role="alert">
            <span class="order-menu-state-icon" aria-hidden="true">!</span>
            <strong>Không thể tải menu</strong>
            <span class="bf-muted">@_errorMessage</span>

            <button type="button" class="btn btn-primary" @onclick="LoadOrderMenuAsync">
                Thử lại
            </button>
        </div>
    }
    else if (_menu is null || _menu.Categories.Count == 0)
    {
        <div class="order-menu-state bf-surface-card" role="status">
            <span class="order-menu-state-icon" aria-hidden="true">☕</span>
            <strong>Menu đang được cập nhật</strong>
            <span class="bf-muted">Chi nhánh hiện chưa có món đang bán.</span>
        </div>
    }
    else
    {
        <header class="order-menu-hero">
            <div class="order-menu-hero-content">
                <h1>Gọi món cho khách</h1>

                <p class="order-menu-branch">
                    @_menu.Branch.Name
                    <span class="order-menu-branch-code">@_menu.Branch.Code</span>
                </p>
            </div>

            <button type="button" class="order-menu-cart-button" aria-label="Mở giỏ hàng, có @GetCartTotalQuantity() món"
                    @onclick="OpenCart">
                <span class="order-menu-cart-icon" aria-hidden="true">🛒</span>
                <span class="order-menu-cart-label">Giỏ hàng</span>
                <span class="order-menu-cart-count">@GetCartTotalQuantity()</span>
            </button>
        </header>

        <section class="order-menu-toolbar bf-surface-card" aria-label="Tìm kiếm và lọc món">
            <div class="order-menu-search">
                <label for="product-keyword" class="visually-hidden">Tìm món</label>

                <input id="product-keyword" type="search" class="form-control order-menu-search-input" value="@_keyword"
                       @oninput="HandleKeywordInput" placeholder="Tìm món theo tên" />
            </div>

            <nav class="order-menu-categories" aria-label="Danh mục món">
                <button type="button"
                        class="order-menu-category-button @(_selectedCategoryId is null ? "active" : string.Empty)"
                        aria-pressed="@(_selectedCategoryId is null)" @onclick="() => SelectCategory(null)">
                    Tất cả
                </button>

                @foreach (OrderMenuCategoryDTO category in _menu.Categories)
                {
                    bool isSelected = _selectedCategoryId == category.Id;

                    <button type="button" class="order-menu-category-button @(isSelected ? "active" : string.Empty)"
                            aria-pressed="@isSelected" @onclick="() => SelectCategory(category.Id)">
                        @category.Name
                    </button>
                }
            </nav>
        </section>

        <section class="order-menu-products" aria-labelledby="product-list-title">
            <div class="order-menu-section-header">
                <div>
                    <h2 id="product-list-title">Danh sách món</h2>
                </div>

                <span class="order-menu-product-count">@_visibleProducts.Count món</span>
            </div>

            @if (_visibleProducts.Count == 0)
            {
                <div class="bf-empty-state" role="status">
                    <span class="order-menu-empty-icon" aria-hidden="true">⌕</span>
                    <strong>Không tìm thấy món phù hợp</strong>
                    <span>Hãy thử từ khóa hoặc danh mục khác.</span>
                </div>
            }
            else
            {
                <div class="order-menu-product-grid">
                    @foreach (OrderMenuProductDTO product in _visibleProducts)
                    {
                        <article class="order-menu-product-card">
                            <div class="order-menu-product-image">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="Ảnh @product.Name" />
                                }
                                else
                                {
                                    <div class="order-menu-image-placeholder">
                                        <span aria-hidden="true">☕</span>
                                        <small>Chưa có ảnh</small>
                                    </div>
                                }

                                <span class="order-menu-price-badge">
                                    @product.MinPrice.ToString("N0") đ
                                </span>
                            </div>

                            <div class="order-menu-product-body">
                                <div>
                                    <h3>@product.Name</h3>
                                    <p>Chọn size và tùy chọn cho khách</p>
                                </div>

                                <button type="button" class="btn btn-primary order-menu-select-button"
                                        @onclick="() => OpenProductOptions(product)">
                                    <span>Chọn món</span>
                                    <span aria-hidden="true">＋</span>
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        @if (_isCartOpen)
        {
            <div class="modal fade show d-block order-menu-modal" tabindex="-1" role="dialog" aria-modal="true"
                 aria-labelledby="cart-title">

                <div class="modal-dialog modal-lg modal-dialog-centered
                    modal-dialog-scrollable">
                    <div class="modal-content border-0 shadow order-menu-modal-content">
                        <div class="modal-header order-menu-modal-header">
                            <div>
                                <p class="small mb-1">
                                    Đơn đang tạo
                                </p>

                                <h2 id="cart-title" class="h5 mb-0">
                                    Giỏ hàng
                                </h2>
                            </div>

                            <button type="button" class="btn-close btn-close-white" aria-label="Đóng giỏ hàng"
                                    disabled="@_isSubmittingOrder" @onclick="CloseCart">
                            </button>
                        </div>

                        
                        <div class="modal-body order-menu-modal-body">
                            @if (!string.IsNullOrWhiteSpace(_orderSubmitErrorMessage))
                            {
                                <div class="alert alert-danger" role="alert">
                                    @_orderSubmitErrorMessage
                                </div>
                            }
                            
                            @if (_cartItems.Count == 0)
                            {
                                <div class="order-menu-cart-empty" role="status">
                                    <span aria-hidden="true">🛒</span>
                                    <strong>Giỏ hàng chưa có món</strong>
                                    <small>Chọn một món trong menu để bắt đầu.</small>
                                </div>
                            }
                            else
                            {
                                <div class="vstack gap-3">
                                    @foreach (OrderCartItemModel cartItem in _cartItems)
                                    {
                                        <article class="order-menu-cart-item">
                                            <div class="d-flex justify-content-between
                                                align-items-start gap-3 mb-2">
                                                <div>
                                                    <h3 class="h6 mb-1">
                                                        @cartItem.ProductName
                                                    </h3>

                                                    <p class="text-secondary small mb-0">
                                                        Size @cartItem.SizeName ·
                                                        Số lượng @cartItem.Quantity
                                                    </p>
                                                </div>

                                                <div class="text-end">
                                                    <strong class="text-success text-nowrap d-block mb-2">
                                                        @cartItem.DisplaySubtotal.ToString("N0") đ
                                                    </strong>

                                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                                            aria-label="Xóa @cartItem.ProductName khỏi giỏ" disabled="@_isSubmittingOrder"
                                                            @onclick="() => RemoveCartItem(cartItem)">
                                                        Xóa
                                                    </button>
                                                </div>
                                            </div>

                                            <p class="small mb-2">
                                                Giá size:
                                                @cartItem.DisplayProductSizePrice.ToString("N0") đ
                                            </p>

                                            @if (cartItem.Toppings.Count > 0)
                                            {
                                                <div class="mb-2">
                                                    <span class="small fw-semibold">
                                                        Topping:
                                                    </span>

                                                    <ul class="small text-secondary mb-0 ps-4">
                                                        @foreach (OrderCartToppingModel topping
                                                                in cartItem.Toppings)
                                                        {
                                                            <li>
                                                                @topping.Quantity × @topping.Name
                                                                (@topping.DisplayUnitPrice.ToString("N0") đ/phần)
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            }

                                            @if (cartItem.Notes.Count > 0)
                                            {
                                                <div>
                                                    <span class="small fw-semibold">
                                                        Ghi chú:
                                                    </span>

                                                    <span class="small text-secondary">
                                                        @string.Join(
                                                            ", ",
                                                            cartItem.Notes.Select(note => note.Name))
                                                    </span>
                                                </div>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                        </div>
                        <div class="modal-footer d-block order-menu-modal-footer">
                            <div class="d-flex justify-content-between
                                align-items-center gap-3">
                                <div>
                                    <span class="text-secondary small d-block">
                                        Tổng cộng
                                    </span>

                                    <strong class="text-success fs-5">
                                        @CalculateCartDisplayTotal().ToString("N0") đ
                                    </strong>
                                </div>
                            </div>

                            <div class="d-grid d-sm-flex
                                justify-content-sm-end gap-2 mt-3">
                                <button type="button" class="btn btn-outline-secondary" disabled="@_isSubmittingOrder"
                                        @onclick="CloseCart">
                                    Tiếp tục chọn món
                                </button>

                                <button type="button" class="btn btn-primary"
                                        disabled="@(_cartItems.Count == 0 || _isSubmittingOrder)" @onclick="SubmitOrderAsync">
                                    @if (_isSubmittingOrder)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true">
                                        </span>

                                        <span>Đang tạo đơn...</span>
                                    }
                                    else
                                    {
                                        <span>Xác nhận tạo đơn</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-backdrop fade show"></div>
        }

        @if (_selectedProduct is OrderMenuProductDTO selectedProduct)
        {
            @* Giao diện tĩnh của cửa sổ tùy chọn món *@
            <div class="modal fade show d-block order-menu-modal" tabindex="-1" role="dialog" aria-modal="true"
                 aria-labelledby="product-option-title">

                <div class="modal-dialog modal-lg modal-dialog-centered
                    modal-dialog-scrollable">
                    <div class="modal-content border-0 shadow order-menu-modal-content">
                        <div class="modal-header order-menu-modal-header">
                            <div class="order-menu-option-summary">
                                <div class="order-menu-option-image">
                                    @if (!string.IsNullOrWhiteSpace(selectedProduct.ImageUrl))
                                    {
                                        <img src="@selectedProduct.ImageUrl"
                                             alt="Ảnh @selectedProduct.Name" />
                                    }
                                    else
                                    {
                                        <span aria-hidden="true">☕</span>
                                    }
                                </div>

                                <div>
                                    <p class="small mb-1">
                                        @GetProductCategoryName(selectedProduct.Id)
                                    </p>

                                    <h2 id="product-option-title" class="h5 mb-1">
                                        Tùy chọn @selectedProduct.Name
                                    </h2>

                                    <span class="order-menu-option-description">
                                        Chọn size trước khi thêm món vào đơn.
                                    </span>
                                </div>
                            </div>

                            <button type="button" class="btn-close btn-close-white" aria-label="Đóng"
                                    @onclick="CloseProductOptions">
                            </button>
                        </div>

                        <div class="modal-body order-menu-modal-body">
                            <section aria-labelledby="size-title">
                                <div class="d-flex justify-content-between
                                    align-items-center mb-3">
                                    <div class="order-menu-step-heading">
                                        <span class="order-menu-step-number">01</span>
                                        <h3 id="size-title" class="h6 mb-0">
                                            Chọn size
                                        </h3>
                                    </div>

                                    <span class="text-danger small">
                                        Bắt buộc
                                    </span>
                                </div>

                                @if (_selectedProductSize is null)
                                {
                                    <p class="text-danger small">
                                        Vui lòng chọn một size để tiếp tục.
                                    </p>
                                }

                                <div class="row g-2">
                                    @foreach (OrderMenuProductSizeDTO productSize in selectedProduct.ProductSizes)
                                    {
                                        bool isSelected = _selectedProductSize?.Id == productSize.Id;

                                        <div class="col-12 col-sm-6">
                                            <button type="button" class="btn @(isSelected ? "btn-success" : "btn-outline-success")
                                                text-start w-100 p-3 order-menu-size-button"
                                                    @onclick="() => SelectProductSize(productSize)">

                                                <span class="d-block fw-semibold">
                                                    @productSize.SizeName
                                                </span>

                                                <span class="small">
                                                    @productSize.Price.ToString("N0") đ
                                                </span>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </section>
                            <section class="border-top pt-4 mt-4" aria-labelledby="topping-title">

                                <div class="d-flex justify-content-between
                                    align-items-center mb-3">
                                    <div class="order-menu-step-heading">
                                        <span class="order-menu-step-number">02</span>
                                        <h3 id="topping-title" class="h6 mb-0">
                                            Topping
                                        </h3>
                                    </div>

                                    <span class="text-secondary small">
                                        Không bắt buộc
                                    </span>
                                </div>

                                @if (_menu.ToppingGroups.Count == 0)
                                {
                                    <p class="text-secondary small mb-0">
                                        Chi nhánh hiện chưa có topping đang bán.
                                    </p>
                                }
                                else
                                {
                                    @foreach (OrderMenuToppingGroupDTO toppingGroup
                                            in _menu.ToppingGroups)
                                    {
                                        <div class="mb-3">
                                            <h4 class="h6 fw-semibold mb-2">
                                                @toppingGroup.Name
                                            </h4>

                                            <div class="border rounded">
                                                @for (int toppingIndex = 0;
                                                    toppingIndex < toppingGroup.Toppings.Count;
                                                    toppingIndex++)
                                                {
                                                    OrderMenuToppingDTO topping =
                                                        toppingGroup.Toppings[toppingIndex];

                                                    int quantity =
                                                        GetToppingQuantity(topping.Id);

                                                    string borderClass =
                                                        toppingIndex > 0
                                                            ? "border-top"
                                                            : string.Empty;

                                                    <div class="d-flex flex-column flex-sm-row order-menu-topping-row
                                                        justify-content-between
                                                        align-items-sm-center gap-3
                                                        @borderClass p-3">

                                                        <div>
                                                            <h5 class="h6 mb-1">
                                                                @topping.Name
                                                            </h5>

                                                            <span class="text-secondary small">
                                                                @topping.UnitPrice.ToString("N0") đ / phần
                                                                · Tối đa @topping.MaxQuantity
                                                            </span>
                                                        </div>

                                                        <div class="d-flex align-items-center gap-2">
                                                            <button type="button" class="btn btn-outline-secondary"
                                                                    aria-label="Giảm @topping.Name" disabled="@(quantity <= 0)"
                                                                    @onclick="() => DecreaseToppingQuantity(topping)">
                                                                −
                                                            </button>

                                                            <span class="fw-semibold text-center" style="min-width: 2rem;">
                                                                @quantity
                                                            </span>

                                                            <button type="button" class="btn btn-outline-success"
                                                                    aria-label="Tăng @topping.Name"
                                                                    disabled="@(quantity >= topping.MaxQuantity)"
                                                                    @onclick="() => IncreaseToppingQuantity(topping)">
                                                                +
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </section>
                            <section class="border-top pt-4 mt-4" aria-labelledby="quick-note-title">

                                <div class="d-flex justify-content-between
                                    align-items-center mb-3">
                                    <div class="order-menu-step-heading">
                                        <span class="order-menu-step-number">03</span>
                                        <h3 id="quick-note-title" class="h6 mb-0">
                                            Ghi chú nhanh
                                        </h3>
                                    </div>

                                    <span class="text-secondary small">
                                        Không bắt buộc
                                    </span>
                                </div>

                                @if (_menu.NoteGroups.Count == 0)
                                {
                                    <p class="text-secondary small mb-0">
                                        Hiện chưa có ghi chú nhanh.
                                    </p>
                                }
                                else
                                {
                                    @foreach (OrderMenuNoteGroupDTO noteGroup
                                            in _menu.NoteGroups)
                                    {
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between
                                                align-items-center gap-2 mb-2">

                                                <h4 class="small fw-semibold mb-0">
                                                    @noteGroup.Name
                                                </h4>

                                                <span class="text-secondary small">
                                                    Chọn tối đa @noteGroup.MaxSelections
                                                </span>
                                            </div>

                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (OrderMenuNoteOptionDTO option
                                                        in noteGroup.Options)
                                                {
                                                    bool isSelected =
                                                        IsNoteOptionSelected(
                                                            noteGroup.Id,
                                                            option.Id);

                                                    <button type="button" class="btn @(isSelected
                                                                ? "btn-success"
                                                                : "btn-outline-secondary")" aria-pressed="@isSelected"
                                                            @onclick="() => ToggleNoteOption(
                                                                noteGroup,
                                                                option)">

@option.Name
</button>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </section>

                            <section class="border-top pt-4 mt-4" aria-labelledby="product-quantity-title">

                                <div class="d-flex justify-content-between
                                    align-items-center gap-3">
                                    <div>
                                        <div class="order-menu-step-heading mb-1">
                                            <span class="order-menu-step-number">04</span>
                                            <h3 id="product-quantity-title" class="h6 mb-0">
                                                Số lượng món
                                            </h3>
                                        </div>

                                        <span class="text-secondary small">
                                            Số lượng món muốn thêm
                                        </span>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="btn btn-outline-secondary" aria-label="Giảm số lượng món"
                                                disabled="@(_productQuantity <= 1)" @onclick="DecreaseProductQuantity">
                                            −
                                        </button>

                                        <span class="fw-semibold text-center" style="min-width: 2rem;">
                                            @_productQuantity
                                        </span>

                                        <button type="button" class="btn btn-outline-success" aria-label="Tăng số lượng món"
                                                @onclick="IncreaseProductQuantity">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </section>
                        </div>

                        <div class="modal-footer order-menu-modal-footer">
                            <button type="button" class="btn btn-primary w-100 order-menu-add-button"
                                    disabled="@(_selectedProductSize is null)" @onclick="AddSelectedProductToCart">

                                <span>
                                    @(_selectedProductSize is null
                                        ? "Chọn size để tiếp tục"
                                        : "Thêm vào đơn")
                                </span>

                                @if (_selectedProductSize is not null)
                                {
                                    <strong>
                                        @CalculateSelectedProductTotal().ToString("N0") đ
                                    </strong>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-backdrop fade show"></div>
        }
    }
</section>
@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private OrderMenuResponseDTO? _menu;
    private int? _selectedCategoryId;
    private string _keyword = string.Empty;

    private List<OrderMenuProductDTO> _visibleProducts =
            new List<OrderMenuProductDTO>();

    // Món đang được employee mở để chọn size và topping
    private OrderMenuProductDTO? _selectedProduct;

    // Size của món đang được employee chọn
    private OrderMenuProductSizeDTO? _selectedProductSize;

    // Lưu số lượng topping đã chọn theo Topping.Id
    private Dictionary<int, int> _selectedToppingQuantities =
            new Dictionary<int, int>();

    // Lưu một NoteOption được chọn trong mỗi NoteGroup
    private Dictionary<int, int> _selectedNoteOptionIds =
        new Dictionary<int, int>();

    // Số lượng của món đang được cấu hình, tối thiểu là 1
    private int _productQuantity = 1;

    // Giữ các món đã chọn trong thời gian employee thao tác trên trang
    private List<OrderCartItemModel> _cartItems =
        new List<OrderCartItemModel>();

    // Cho biết employee đang mở hay đóng phần chi tiết giỏ hàng
    private bool _isCartOpen;

    // Xóa đúng dòng cấu hình được chọn khỏi giỏ hàng
    private void RemoveCartItem(OrderCartItemModel cartItem)
    {
        _cartItems.Remove(cartItem);
    }

    // Trạng thái gửi đơn lên API
    private bool _isSubmittingOrder;
    private string? _orderSubmitErrorMessage;
    private CreateOrderResponseDTO? _createOrder;

    // Chỉ đọc LocalStorage và tải dữ liệu lần render đầu tiên
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadOrderMenuAsync();

        // OnAfterRenderAsync không tự render lại khi await hoàn thành
        StateHasChanged();
    }

    // Lấy chi nhánh hiện tại rồi tải menu tương ứng
    private async Task LoadOrderMenuAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _menu = null;
        _selectedCategoryId = null;
        _keyword = string.Empty;
        _visibleProducts.Clear();

        try
        {
            UserProfileDTO? profile =
                await UserApiService.GetCurrentProfileAsync();

            if (profile is null)
            {
                _errorMessage = "Không thể tải thông tin tài khoản.";
                return;
            }

            if (!profile.CurrentBranchId.HasValue)
            {
                _errorMessage = "Tài khoản chưa được phân công tại chi nhánh.";
                return;
            }

            _menu = await OrderMenuApiService.GetOrderMenuAsync(
                profile.CurrentBranchId.Value);

            if (_menu is null)
            {
                _errorMessage = "Không thể tải menu. Vui lòng thử lại.";
                return;
            }

            ApplyProductFilter();
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Không thể kết nối đến API.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Tìm tên danh mục của món để hiển thị trong phần cấu hình.
    private string GetProductCategoryName(int productId)
    {
        if (_menu is null)
        {
            return "Món đang chọn";
        }

        foreach (OrderMenuCategoryDTO category in _menu.Categories)
        {
            foreach (OrderMenuProductDTO product in category.Products)
            {
                if (product.Id == productId)
                {
                    return category.Name;
                }
            }
        }

        return "Món đang chọn";
    }

    // Ghi nhận danh mục được chọn rồi lọc lại sản phẩm
    private void SelectCategory(int? categoryId)
    {
        _selectedCategoryId = categoryId;

        ApplyProductFilter();
    }

    // Ghi nhận món được chọn để chuẩn bị hiển thị modal tùy chọn
    private void OpenProductOptions(OrderMenuProductDTO product)
    {
        _selectedProduct = product;
        _selectedProductSize = null;
        _selectedToppingQuantities.Clear();
        _selectedNoteOptionIds.Clear();
        _productQuantity = 1;
    }

    // Ghi nhận ProductSize cụ thể mà employee đã chọn
    private void SelectProductSize(OrderMenuProductSizeDTO productSize)
    {
        _selectedProductSize = productSize;
    }

    // Lấy số lượng hiện tại của topping, chưa chọn thì trả về 0
    private int GetToppingQuantity(int toppingId)
    {
        if (_selectedToppingQuantities.TryGetValue(toppingId, out int quantity))
        {
            return quantity;
        }

        return 0;
    }

    // Tăng số lượng nhưng không vượt quá giới hạn API trả về
    private void IncreaseToppingQuantity(OrderMenuToppingDTO topping)
    {
        int currentQuantity = GetToppingQuantity(topping.Id);

        if (currentQuantity >= topping.MaxQuantity)
        {
            return;
        }

        _selectedToppingQuantities[topping.Id] = currentQuantity + 1;
    }

    // Giảm số lượng và xóa khỏi danh sách khi trở về 0
    private void DecreaseToppingQuantity(OrderMenuToppingDTO topping)
    {
        int currentQuantity = GetToppingQuantity(topping.Id);

        if (currentQuantity <= 0)
        {
            return;
        }

        if (currentQuantity == 1)
        {
            _selectedToppingQuantities.Remove(topping.Id);
            return;
        }

        _selectedToppingQuantities[topping.Id] = currentQuantity - 1;
    }

    // Kiểm tra option có phải lựa chọn hiện tại của nhóm không
    private bool IsNoteOptionSelected(int noteGroupId, int noteOptionId)
    {
        if (_selectedNoteOptionIds.TryGetValue(noteGroupId, out int selectedOptionId))
        {
            return selectedOptionId == noteOptionId;
        }

        return false;
    }

    // Chọn một option hoặc bỏ chọn nếu người dùng bấm lại
    private void ToggleNoteOption(
        OrderMenuNoteGroupDTO noteGroup,
        OrderMenuNoteOptionDTO option)
    {
        bool isSelected = IsNoteOptionSelected(noteGroup.Id, option.Id);

        if (isSelected)
        {
            _selectedNoteOptionIds.Remove(noteGroup.Id);
            return;
        }

        _selectedNoteOptionIds[noteGroup.Id] = option.Id;
    }

    // Tăng số lượng món thêm vào giỏ
    private void IncreaseProductQuantity()
    {
        _productQuantity++;
    }

    // Giảm số lượng nhưng không cho phép thấp hơn 1
    private void DecreaseProductQuantity()
    {
        if (_productQuantity <= 1)
        {
            return;
        }

        _productQuantity--;
    }

    // Tạm tính toàn bộ cấu hình món đang chọn
    private decimal CalculateSelectedProductTotal()
    {
        if (_selectedProductSize is null || _menu is null)
        {
            return 0m;
        }

        decimal configuredProductUnitPrice = _selectedProductSize.Price;

        foreach (OrderMenuToppingGroupDTO toppingGroup in _menu.ToppingGroups)
        {
            foreach (OrderMenuToppingDTO topping in toppingGroup.Toppings)
            {
                int toppingQuantity = GetToppingQuantity(topping.Id);

                configuredProductUnitPrice += topping.UnitPrice * toppingQuantity;
            }
        }

        return configuredProductUnitPrice * _productQuantity;
    }

    // Sao chép cấu hình món hiện tại thành một dòng trong giỏ hàng
    private void AddSelectedProductToCart()
    {
        if (_selectedProduct is null ||
            _selectedProductSize is null ||
            _menu is null)
        {
            return;
        }

        OrderCartItemModel cartItem = new OrderCartItemModel
        {
            ProductSizeId = _selectedProductSize.Id,
            ProductName = _selectedProduct.Name,
            SizeName = _selectedProductSize.SizeName,
            Quantity = _productQuantity,
            DisplayProductSizePrice = _selectedProductSize.Price,
            DisplaySubtotal = CalculateSelectedProductTotal()
        };

        // Chỉ sao chép những topping có số lượng lớn hơn 0
        foreach (OrderMenuToppingGroupDTO toppingGroup in _menu.ToppingGroups)
        {
            foreach (OrderMenuToppingDTO topping in toppingGroup.Toppings)
            {
                int toppingQuantity = GetToppingQuantity(topping.Id);

                if (toppingQuantity <= 0)
                {
                    continue;
                }

                cartItem.Toppings.Add(new OrderCartToppingModel
                {
                    ToppingId = topping.Id,
                    Name = topping.Name,
                    Quantity = toppingQuantity,
                    DisplayUnitPrice = topping.UnitPrice
                });
            }
        }

        // Tìm tên của từng NoteOption đã chọn để hiển thị trong giỏ
        foreach (OrderMenuNoteGroupDTO noteGroup in _menu.NoteGroups)
        {
            if (!_selectedNoteOptionIds.TryGetValue(
                noteGroup.Id, out int selectedOptionId))
            {
                continue;
            }

            foreach (OrderMenuNoteOptionDTO option in noteGroup.Options)
            {
                if (option.Id != selectedOptionId)
                {
                    continue;
                }

                cartItem.Notes.Add(new OrderCartNoteModel
                {
                    NoteOptionId = option.Id,
                    Name = option.Name
                });

                break;
            }
        }

        _cartItems.Add(cartItem);
        CloseProductOptions();
    }

    // Tính tổng số lượng của tất cả các dòng trong giỏ hàng
    private int GetCartTotalQuantity()
    {
        int totalQuantity = 0;

        foreach (OrderCartItemModel cartItem in _cartItems)
        {
            totalQuantity += cartItem.Quantity;
        }

        return totalQuantity;
    }

    // Tính tổng tiền hiển thị của tất cả dòng trong giỏ
    private decimal CalculateCartDisplayTotal()
    {
        decimal totalAmount = 0m;

        foreach (OrderCartItemModel cartItem in _cartItems)
        {
            totalAmount += cartItem.DisplaySubtotal;
        }

        return totalAmount;
    }

    // Mở phần chi tiết giỏ hàng
    private void OpenCart()
    {
        _isCartOpen = true;
    }

    // Đóng phần chi tiết giỏ hàng
    private void CloseCart()
    {
        _isCartOpen = false;
    }

    // Đóng modal và xóa món đang được chọn
    private void CloseProductOptions()
    {
        _selectedProduct = null;
        _selectedProductSize = null;
        _selectedToppingQuantities.Clear();
        _selectedNoteOptionIds.Clear();
        _productQuantity = 1;
    }

    // Nhận từ khóa mới và lọc lại danh sách món
    private void HandleKeywordInput(ChangeEventArgs eventArgs)
    {
        _keyword = eventArgs.Value?.ToString() ?? string.Empty;

        ApplyProductFilter();
    }

    // Tạo danh sách sản phẩm cần hiển thị
    private void ApplyProductFilter()
    {
        _visibleProducts.Clear();

        if (_menu is null)
        {
            return;
        }

        string normalizedKeyword =
                    RemoveVietnameseDiacritics(_keyword.Trim());

        foreach (OrderMenuCategoryDTO category in _menu.Categories)
        {
            // null là chọn Tất cả; có Id thì chỉ lấy đúng danh mục
            if (_selectedCategoryId.HasValue
                && category.Id != _selectedCategoryId.Value)
            {
                continue;
            }

            foreach (OrderMenuProductDTO product in category.Products)
            {
                string normalizedProductName =
                    RemoveVietnameseDiacritics(product.Name);

                // So sánh hai chuỗi đã được loại bỏ dấu
                if (!string.IsNullOrWhiteSpace(normalizedKeyword)
                    && !normalizedProductName.Contains(
                        normalizedKeyword,
                        StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                _visibleProducts.Add(product);
            }
        }
    }

    // Chuẩn hóa tiếng Việt để hỗ trợ tìm kiếm không dấu
    private static string RemoveVietnameseDiacritics(string value)
    {
        string normalizedValue =
            value.Normalize(NormalizationForm.FormD);

        StringBuilder result = new StringBuilder();

        foreach (char character in normalizedValue)
        {
            UnicodeCategory category =
                CharUnicodeInfo.GetUnicodeCategory(character);

            if (category != UnicodeCategory.NonSpacingMark)
            {
                result.Append(character);
            }
        }

        return result
            .ToString()
            .Normalize(NormalizationForm.FormC)
            .Replace('đ', 'd')
            .Replace('Đ', 'D');
    }

    // Chuyển dữ liệu giỏ hàng thành request gửi đến API
    private CreateOrderRequestDTO? BuildCreateOrderRequest()
    {
        if (_menu is null || _cartItems.Count == 0)
        {
            return null;
        }

        CreateOrderRequestDTO request = new CreateOrderRequestDTO
        {
            BranchId = _menu.Branch.Id
        };

        foreach (OrderCartItemModel cartItem in _cartItems)
        {
            CreateOrderItemRequestDTO requestItem =
                new CreateOrderItemRequestDTO
                {
                    ProductSizeId = cartItem.ProductSizeId,
                    Quantity = cartItem.Quantity
                };

            // Chuyển ID và số lượng topping vào request
            foreach (OrderCartToppingModel cartTopping in cartItem.Toppings)
            {
                requestItem.Toppings.Add(
                    new CreateOrderItemToppingRequestDTO
                    {
                        ToppingId = cartTopping.ToppingId,
                        Quantity = cartTopping.Quantity
                    });
            }

            // Mỗi ghi chú chỉ cần gửi NoteOptionId
            foreach (OrderCartNoteModel cartNote in cartItem.Notes)
            {
                requestItem.NoteOptionIds.Add(cartNote.NoteOptionId);
            }

            request.Items.Add(requestItem);
        }

        return request;
    }

    // Gửi toàn bộ giỏ hàng đến API để tạo đơn
    private async Task SubmitOrderAsync()
    {
        if (_isSubmittingOrder)
        {
            return;
        }

        CreateOrderRequestDTO? request = BuildCreateOrderRequest();

        if (request is null)
        {
            _orderSubmitErrorMessage = "Giỏ hàng chưa có món để tạo đơn.";

            return;
        }

        _isSubmittingOrder = true;
        _orderSubmitErrorMessage = null;
        _createOrder = null;

        try
        {
            OrderCreateApiResult result =
                await OrderApiService.CreateOrderAsync(request);

            if (!result.IsSuccess || result.Order is null)
            {
                _orderSubmitErrorMessage =
                    string.IsNullOrWhiteSpace(result.ErrorMessage)
                        ? "Không thể tạo đơn hàng."
                        : result.ErrorMessage;

                return;
            }

            // Chỉ xóa giỏ sau khi Backend xác nhận đã tạo đơn
            _createOrder = result.Order;
            _cartItems.Clear();
            _isCartOpen = false;
        }
        catch (HttpRequestException)
        {
            _orderSubmitErrorMessage = "Không thể kết nối API.";
        }
        finally
        {
            _isSubmittingOrder = false;
        }
    }

}
