@using System.Text.Json
@using Microsoft.JSInterop
@using TuanKietBranchFlow.Application.DTOs.MenuManagement
@using TuanKietBranchFlow.Web.Services
@using TuanKietBranchFlow.Web.Models

@inject CategoryApiService CategoryApiService

<section class="bf-surface-card overflow-hidden" aria-labelledby="category-title">
    <header class="d-flex flex-column flex-sm-row align-items-sm-center
        justify-content-between gap-3 p-3 p-md-4 border-bottom">
        <div>
            <h2 id="category-title" class="h5 mb-1">Danh mục món</h2>
            <p class="bf-page-description mb-0">
                Trạng thái danh mục áp dụng cho tất cả chi nhánh.
            </p>
        </div>

        <AuthorizeView Roles="ADMIN">
            <Authorized>
                <button type="button" class="btn btn-primary align-self-start align-self-sm-auto"
                        @onclick="ShowCreateCategoryForm" disabled="@HasOpenOperation">
                    Thêm danh mục
                </button>
            </Authorized>
        </AuthorizeView>
    </header>

    <AuthorizeView Roles="ADMIN">
        <Authorized>
            @if (_isCreateCategoryFormVisible)
            {
                <section class="p-3 p-md-4 border-bottom bg-body-tertiary" aria-labelledby="create-category-title">
                    <h3 id="create-category-title" class="h6 mb-3">
                        Thêm danh mục
                    </h3>

                    @if (!string.IsNullOrWhiteSpace(_createCategoryErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @_createCategoryErrorMessage
                        </div>
                    }

                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md">
                            <label for="category-name" class="form-label">
                                Tên danh mục
                            </label>
                            <input id="category-name" type="text" class="form-control" maxlength="150"
                                   placeholder="Ví dụ: Trà sữa" aria-describedby="category-name-help"
                                   @bind="_newCategoryName" @bind:event="oninput" disabled="@_isCreatingCategory" />
                            <div id="category-name-help" class="form-text">
                                Tên danh mục tối đa 150 ký tự.
                            </div>
                        </div>

                        <div class="col-12 col-md-auto d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelCreateCategory"
                                    disabled="@_isCreatingCategory">
                                Hủy
                            </button>

                            <button type="button" class="btn btn-primary" @onclick="CreateCategoryAsync"
                                    disabled="@_isCreatingCategory">
                                @if (_isCreatingCategory)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                    <span>Đang lưu...</span>
                                }
                                else
                                {
                                    <span>Lưu danh mục</span>
                                }
                            </button>
                        </div>
                    </div>
                </section>
            }
        </Authorized>
    </AuthorizeView>

    @if (_isLoading)
    {
        <div class="p-4" aria-live="polite">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Đang tải danh mục</span>
            </div>
            <p class="mb-0 mt-2">Đang tải danh mục...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="p-4" role="alert">
            <p class="text-danger mb-3">@_errorMessage</p>
            <button type="button" class="btn btn-outline-primary" @onclick="LoadCategoriesAsync" disabled="@HasOpenOperation">
                Thử lại
            </button>
        </div>
    }
    else if (_categories.Count == 0)
    {
        <div class="p-4" role="status">
            Chưa có danh mục món.
        </div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (MenuCategoryDTO category in _categories)
            {
                <article class="list-group-item p-3 p-md-4">
                    <div class="d-flex flex-column flex-sm-row
                        align-items-sm-center justify-content-between gap-2">
                        <h3 class="h6 mb-0">@category.Name</h3>

                        <div class="d-flex align-items-center gap-2">
                            <span class="badge rounded-pill
                                @(category.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(category.IsActive ? "Đang hoạt động" : "Tạm ngừng")
                            </span>

                            <AuthorizeView Roles="ADMIN">
                                <Authorized>
                                    @if (_editingCategoryId == category.Id)
                                    {
                                        <span class="badge text-bg-primary">Đang chỉnh sửa</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm"
                                                @onclick="() => BeginEditCategory(category)" disabled="@HasOpenOperation">
                                            Sửa
                                        </button>
                                    }

                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            @onclick="() => RequestCategoryDelete(category)"
                                            disabled="@HasOpenOperation">
                                        @if (_deletingCategoryId == category.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                            <span>Đang xóa...</span>
                                        }
                                        else
                                        {
                                            <span>Xóa</span>
                                        }
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </div>

                    <AuthorizeView Roles="ADMIN">
                        <Authorized>
                            @if (_editingCategoryId == category.Id)
                            {
                                <div class="mt-3 p-3 border rounded bg-body-tertiary">
                                    <h4 class="h6 mb-3">Thông tin danh mục</h4>

                                    @if (!string.IsNullOrWhiteSpace(_updateCategoryErrorMessage))
                                    {
                                        <div class="alert alert-danger" role="alert">
                                            @_updateCategoryErrorMessage
                                        </div>
                                    }

                                    <div class="row g-3 align-items-end">
                                        <div class="col-12 col-md-7">
                                            <label for="category-name-@category.Id" class="form-label">
                                                Tên danh mục
                                            </label>
                                            <input id="category-name-@category.Id" type="text" class="form-control"
                                                   maxlength="150" @bind="_editedCategoryName" @bind:event="oninput"
                                                   disabled="@_isUpdatingCategory" />
                                        </div>

                                        <div class="col-12 col-md-5">
                                            <label for="category-status-@category.Id" class="form-label">
                                                Trạng thái
                                            </label>
                                            <select id="category-status-@category.Id" class="form-select"
                                                    value="@_editedCategoryIsActive.ToString().ToLowerInvariant()"
                                                    @onchange="HandleCategoryStatusChanged" disabled="@_isUpdatingCategory">
                                                <option value="true">Đang hoạt động</option>
                                                <option value="false">Tạm ngừng</option>
                                            </select>
                                        </div>

                                        <div class="col-12 d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-outline-secondary"
                                                    @onclick="CancelEditCategory" disabled="@_isUpdatingCategory">
                                                Hủy
                                            </button>

                                            <button type="button" class="btn btn-primary" @onclick="SaveCategoryChangesAsync"
                                                    disabled="@_isUpdatingCategory">
                                                @if (_isUpdatingCategory)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                                    <span>Đang lưu...</span>
                                                }
                                                else
                                                {
                                                    <span>Lưu thay đổi</span>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </Authorized>
                    </AuthorizeView>
                </article>
            }
        </div>
    }
</section>

@if (_categoryPendingDelete is not null)
{
    <AuthorizeView Roles="ADMIN">
        <Authorized>
            <div class="modal-backdrop fade show" aria-hidden="true"></div>

            <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true"
                 aria-labelledby="delete-category-confirm-title" aria-describedby="delete-category-confirm-description">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 id="delete-category-confirm-title" class="modal-title fs-5">
                                Xác nhận xóa danh mục
                            </h2>
                        </div>

                        <div class="modal-body">
                            <p id="delete-category-confirm-description">
                                Bạn có chắc muốn xóa danh mục
                                <strong>@_categoryPendingDelete.Name</strong>?
                            </p>

                            <div class="alert alert-warning mb-0">
                                Danh mục sẽ bị ẩn khỏi menu nhân viên ở tất cả chi nhánh.
                                Dữ liệu vẫn được giữ trong database.
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_deleteCategoryErrorMessage))
                            {
                                <div class="alert alert-danger mt-3 mb-0" role="alert">
                                    @_deleteCategoryErrorMessage
                                </div>
                            }
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelCategoryDelete"
                                    disabled="@_deletingCategoryId.HasValue">
                                Hủy
                            </button>

                            <button type="button" class="btn btn-danger" @onclick="ConfirmCategoryDeleteAsync"
                                    disabled="@_deletingCategoryId.HasValue">
                                @if (_deletingCategoryId == _categoryPendingDelete.Id)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                    <span>Đang xóa...</span>
                                }
                                else
                                {
                                    <span>Xác nhận xóa</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>
}

@code {
    // Báo trạng thái thao tác cho Menu để giữ đúng tab đang làm việc
    [Parameter] public EventCallback<bool> OnBusyChanged { get; set; }
    private bool _lastBusyState;

    // Khóa chuyển tab khi đang tải, nhập form hoặc xác nhận xóa
    private bool HasOpenOperation =>
        _isLoading || _isCreateCategoryFormVisible || _isCreatingCategory
        || _editingCategoryId.HasValue || _isUpdatingCategory
        || _categoryPendingDelete != null || _deletingCategoryId.HasValue;

    // State của danh sách danh mục và quá trình tải dữ liệu
    private List<MenuCategoryDTO> _categories =
        new List<MenuCategoryDTO>();

    private bool _isLoading = true;
    private string? _errorMessage;

    // State của form tạo danh mục
    private bool _isCreateCategoryFormVisible;
    private string _newCategoryName = string.Empty;
    private bool _isCreatingCategory;
    private string? _createCategoryErrorMessage;

    // State của form sửa danh mục
    private int? _editingCategoryId;
    private string _editedCategoryName = string.Empty;
    private bool _editedCategoryIsActive;
    private bool _isUpdatingCategory;
    private string? _updateCategoryErrorMessage;

    // State của xác nhận và quá trình xóa danh mục
    private int? _deletingCategoryId;
    private string? _deleteCategoryErrorMessage;
    private MenuCategoryDTO? _categoryPendingDelete;

    // Tải sau render đầu tiên để có thể đọc token từ localStorage
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadCategoriesAsync();
            StateHasChanged();
        }

        bool isBusy = HasOpenOperation;
        if (_lastBusyState != isBusy)
        {
            _lastBusyState = isBusy;
            await OnBusyChanged.InvokeAsync(isBusy);
        }
        else if (firstRender)
        {
            // Mở khóa tab cả khi lần tải đầu không có dữ liệu hoặc gặp lỗi
            await OnBusyChanged.InvokeAsync(isBusy);
        }
    }

    // Tải danh mục và lưu trạng thái để vòng sau hiển thị lên giao diện
    private async Task LoadCategoriesAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            List<MenuCategoryDTO>? categories =
                await CategoryApiService.GetMenuCategoriesAsync();

            if (categories is null)
            {
                _errorMessage = "Không thể tải danh mục. Vui lòng thử lại";
                return;
            }

            _categories = categories;
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Không thể kết nối đến API.";
        }
        catch (JSException)
        {
            _errorMessage = "Không thể đọc token đăng nhập.";
        }
        catch (JsonException)
        {
            _errorMessage = "Dữ liệu danh mục từ API không hợp lệ.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Mở form và xóa lỗi cũ
    private void ShowCreateCategoryForm()
    {
        if (HasOpenOperation)
        {
            return;
        }

        _isCreateCategoryFormVisible = true;
        _newCategoryName = string.Empty;
        _createCategoryErrorMessage = null;
    }

    // Đóng form và xóa dữ liệu đang nhập
    private void CancelCreateCategory()
    {
        _isCreateCategoryFormVisible = false;
        _newCategoryName = string.Empty;
        _createCategoryErrorMessage = null;
    }

    // Tạo danh mục qua API
    private async Task CreateCategoryAsync()
    {
        if (_isCreatingCategory)
        {
            return;
        }

        _createCategoryErrorMessage = null;

        if (string.IsNullOrWhiteSpace(_newCategoryName))
        {
            _createCategoryErrorMessage = "Vui lòng nhập tên danh mục.";
            return;
        }

        _isCreatingCategory = true;

        try
        {
            CreateCategoryRequestDTO request =
                new CreateCategoryRequestDTO
                {
                    Name = _newCategoryName
                };

            CategoryCreateApiResult result =
                await CategoryApiService.CreateCategoryAsync(request);

            if (!result.IsSuccess || result.Category == null)
            {
                if (string.IsNullOrWhiteSpace(result.ErrorMessage))
                {
                    _createCategoryErrorMessage = "Không thể tạo danh mục. Vui lòng thử lại.";
                }
                else
                {
                    _createCategoryErrorMessage = result.ErrorMessage;
                }

                return;
            }

            _categories.Add(result.Category);
            _newCategoryName = string.Empty;
            _isCreateCategoryFormVisible = false;
        }
        catch (HttpRequestException)
        {
            _createCategoryErrorMessage = "Không thể kết nối đến API.";
        }
        catch (JSException)
        {
            _createCategoryErrorMessage = "Không thể đọc token đăng nhập.";
        }
        catch (JsonException)
        {
            _createCategoryErrorMessage = "Dữ liệu danh mục từ API không hợp lệ.";
        }
        finally
        {
            _isCreatingCategory = false;
        }

    }

    // Nạp dữ liệu danh mục được chọn vào state chỉnh sửa
    private void BeginEditCategory(MenuCategoryDTO category)
    {
        if (HasOpenOperation)
        {
            return;
        }

        _editingCategoryId = category.Id;
        _editedCategoryName = category.Name;
        _editedCategoryIsActive = category.IsActive;
        _updateCategoryErrorMessage = null;
    }

    // Đổi giá trị chuỗi từ select thành trạng thái bool đang chỉnh sửa
    private void HandleCategoryStatusChanged(ChangeEventArgs eventArgs)
    {
        if (bool.TryParse(eventArgs.Value?.ToString(), out bool isActive))
        {
            _editedCategoryIsActive = isActive;
        }
    }

    // Hủy chỉnh sửa và xóa state tạm
    private void CancelEditCategory()
    {
        if (_isUpdatingCategory)
        {
            return;
        }

        _editingCategoryId = null;
        _editedCategoryName = string.Empty;
        _editedCategoryIsActive = false;
        _updateCategoryErrorMessage = null;
    }

    // Gửi thay đổi lên API và cập nhật danh sách trên giao diện
    private async Task SaveCategoryChangesAsync()
    {
        if (_editingCategoryId == null || _isUpdatingCategory)
        {
            return;
        }

        _updateCategoryErrorMessage = null;

        if (string.IsNullOrWhiteSpace(_editedCategoryName))
        {
            _updateCategoryErrorMessage = "Vui lòng nhập tên danh mục.";
            return;
        }

        if (_editedCategoryName.Trim().Length > 150)
        {
            _updateCategoryErrorMessage = "Tên danh mục không được vượt quá 150 ký tự.";
            return;
        }

        _isUpdatingCategory = true;

        try
        {
            UpdateCategoryRequestDTO request =
                new UpdateCategoryRequestDTO
                {
                    Name = _editedCategoryName,
                    IsActive = _editedCategoryIsActive
                };

            CategoryUpdateApiResult result =
                await CategoryApiService.UpdateCategoryAsync(
                    _editingCategoryId.Value,
                    request);

            if (!result.IsSuccess || result.Category == null)
            {
                _updateCategoryErrorMessage =
                    string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "Không thể cập nhật danh mục. Vui lòng thử lại."
                    : result.ErrorMessage;

                return;
            }

            for (int index = 0; index < _categories.Count; index++)
            {
                if (_categories[index].Id == result.Category.Id)
                {
                    _categories[index] = result.Category;
                    break;
                }
            }

            _editingCategoryId = null;
            _editedCategoryName = string.Empty;
            _editedCategoryIsActive = false;
            _updateCategoryErrorMessage = null;
        }
        catch (HttpRequestException)
        {
            _updateCategoryErrorMessage = "Không thể kết nối đến API.";
        }
        catch (JSException)
        {
            _updateCategoryErrorMessage = "Không thể đọc token đăng nhập.";
        }
        catch (JsonException)
        {
            _updateCategoryErrorMessage = "Dữ liệu danh mục từ API không hợp lệ.";
        }
        finally
        {
            _isUpdatingCategory = false;
        }
    }

    // Mở hộp thoại xác nhận trước khi bắt đầu xóa danh mục
    private void RequestCategoryDelete(MenuCategoryDTO category)
    {
        if (HasOpenOperation)
        {
            return;
        }

        if (_deletingCategoryId.HasValue
            || _editingCategoryId.HasValue
            || _isUpdatingCategory)
        {
            return;
        }

        _deleteCategoryErrorMessage = null;
        _categoryPendingDelete = category;
    }

    // Đóng hộp thoại mà không gửi yêu cầu đến API
    private void CancelCategoryDelete()
    {
        if (_deletingCategoryId.HasValue)
        {
            return;
        }

        _categoryPendingDelete = null;
        _deleteCategoryErrorMessage = null;
    }

    // Chỉ gửi yêu cầu xóa sau khi ADMIN xác nhận
    private async Task ConfirmCategoryDeleteAsync()
    {
        MenuCategoryDTO? category = _categoryPendingDelete;

        if (category is null
            || _deletingCategoryId.HasValue
            || _editingCategoryId.HasValue
            || _isUpdatingCategory)
        {
            return;
        }

        await DeleteCategoryAsync(category);
    }

    // Xóa danh mục qua API và cập nhật giao diện khi thành công
    private async Task DeleteCategoryAsync(MenuCategoryDTO category)
    {
        if (_categoryPendingDelete?.Id != category.Id
            || _deletingCategoryId.HasValue
            || _editingCategoryId.HasValue
            || _isUpdatingCategory)
        {
            return;
        }

        _deleteCategoryErrorMessage = null;
        _deletingCategoryId = category.Id;

        try
        {
            CategoryDeleteApiResult result =
                await CategoryApiService.DeleteCategoryAsync(category.Id);

            if (!result.IsSuccess)
            {
                _deleteCategoryErrorMessage =
                    string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "Không thể xóa danh mục. Vui lòng thử lại."
                    : result.ErrorMessage;

                return;
            }

            _categories.Remove(category);
            _categoryPendingDelete = null;
        }
        catch (HttpRequestException)
        {
            _deleteCategoryErrorMessage = "Không thể kết nối đến API.";
        }
        catch (JSException)
        {
            _deleteCategoryErrorMessage = "Không thể đọc token đăng nhập.";
        }
        catch (JsonException)
        {
            _deleteCategoryErrorMessage = "Dữ liệu lỗi từ API không hợp lệ.";
        }
        finally
        {
            _deletingCategoryId = null;
        }
    }
}
