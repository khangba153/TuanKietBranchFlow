        {
            _createToppingErrorMessage = "Vui lòng nhập tên topping.";
            return;
        }

        string toppingName = _newToppingName.Trim();

        if (toppingName.Length > 150)
        {
            _createToppingErrorMessage =
                "Tên topping không được vượt quá 150 ký tự.";
            return;
        }

        if (!_newToppingPrice.HasValue
            || _newToppingPrice.Value <= 0
            || _newToppingPrice.Value > 9999999999999999.99m
            || decimal.Round(_newToppingPrice.Value, 2) != _newToppingPrice.Value)
