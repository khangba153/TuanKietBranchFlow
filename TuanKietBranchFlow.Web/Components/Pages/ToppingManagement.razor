            .FirstOrDefault(group => group.Id == _creatingToppingGroupId.Value);

        if (toppingGroup == null)
        {
            _createToppingErrorMessage = "Không tìm thấy nhóm topping đang chọn.";
            return;
        }

        _isCreatingTopping = true;

        try
        {
            CreateToppingRequestDTO request = new CreateToppingRequestDTO
            {
                ToppingGroupId = toppingGroup.Id,
                Name = toppingName,
                Price = _newToppingPrice.Value
            };

            ToppingCreateApiResult result =
                await ToppingApiService.CreateToppingAsync(request);

            if (!result.IsSuccess || result.Topping == null)
            {
                _createToppingErrorMessage =
                    string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "Không thể tạo topping. Vui lòng thử lại."
                    : result.ErrorMessage;

                return;
            }

            // Chỉ thêm dữ liệu vào nhóm sau khi API xác nhận thành công
            toppingGroup.Toppings.Add(result.Topping);

            _creatingToppingGroupId = null;
            _newToppingName = string.Empty;
            _newToppingPrice = null;
        }
        catch (HttpRequestException)
        {
            _createToppingErrorMessage = "Không thể kết nối đến API.";
