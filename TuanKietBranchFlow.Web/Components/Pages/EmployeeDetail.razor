@page "/employees/{EmployeeId:int}"

@using Microsoft.JSInterop
@using TuanKietBranchFlow.Application.DTOs.Employees
@using TuanKietBranchFlow.Web.Services

@inject EmployeeApiService EmployeeApiService

<PageTitle>@(_employee?.FullName ?? "Hồ sơ nhân viên")</PageTitle>

<div class="employee-detail-page bf-page">
    @if (_isLoading)
    {
        <section class="employee-detail-state bf-surface-card" aria-live="polite">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Đang tải hồ sơ nhân viên</span>
            </div>
            <h1 class="h5 mb-0">Đang tải hồ sơ</h1>
            <p>Hệ thống đang lấy thông tin nhân viên và lịch sử phân công.</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="employee-detail-state employee-detail-state-error bf-surface-card" role="alert">
            <h1 class="h5 mb-0">Không thể tải hồ sơ</h1>
            <p>@_errorMessage</p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a class="btn btn-outline-secondary" href="@($"/employees?branchId={BranchId}")">
                    Quay lại danh sách
                </a>
                <button type="button" class="btn btn-danger" @onclick="LoadEmployeeAsync">
                    Thử lại
                </button>
            </div>
        </section>
    }
    else if (_employee is null)
    {
        <section class="employee-detail-state bf-surface-card" role="status">
            <h1 class="h5 mb-0">Không tìm thấy hồ sơ nhân viên</h1>
            <p>Hãy quay lại danh sách và chọn hồ sơ bạn cần xem.</p>
            <a class="btn btn-outline-primary" href="@($"/employees?branchId={BranchId}")">
                Quay lại danh sách
            </a>
        </section>
    }
    else
    {
        <header class="employee-detail-hero">
            <div class="employee-detail-hero-copy">
                <a class="employee-detail-back-link" href="@($"/employees?branchId={BranchId}")">
                    <span aria-hidden="true">←</span> Danh sách nhân viên
                </a>
                <h1>@_employee.FullName</h1>
                <span class="employee-detail-status @(_employee.IsActive ? "is-active" : "is-inactive")">
                    <span aria-hidden="true"></span>
                    @(_employee.IsActive ? "Đang làm việc" : "Đã nghỉ việc")
                </span>
            </div>
        </header>

        <div class="employee-detail-content">
            <aside class="employee-detail-profile bf-surface-card" aria-label="Tóm tắt nhân viên">
                @if (!string.IsNullOrWhiteSpace(_employee.AvatarUrl))
                {
                    <img class="employee-detail-avatar"
                         src="@_employee.AvatarUrl"
                         alt="Ảnh đại diện của @_employee.FullName" />
                }
                else
                {
                    <span class="employee-detail-avatar employee-detail-avatar-fallback" aria-hidden="true">
                        @GetEmployeeInitial(_employee.FullName)
                    </span>
                }

                <p class="employee-detail-code">@_employee.EmployeeCode</p>
                <p class="employee-detail-position">@DisplayValue(_employee.Position)</p>

                <div class="employee-detail-profile-separator"></div>

                <dl class="employee-detail-profile-facts">
                    <div>
                        <dt>Ngày vào làm</dt>
                        <dd>@_employee.HireDate.ToString("dd/MM/yyyy")</dd>
                    </div>
                    <div>
                        <dt>Lần phân công</dt>
                        <dd>@_employee.BranchHistory.Count</dd>
                    </div>
                </dl>
            </aside>

            <div class="employee-detail-main">
                <section class="employee-detail-section bf-surface-card" aria-labelledby="employee-personal-title">
                    <div class="employee-detail-section-heading">
                        <div>
                            <h2 id="employee-personal-title">Thông tin cá nhân</h2>
                        </div>
                    </div>

                    <dl class="employee-detail-fields">
                        <div>
                            <dt>Mã nhân viên</dt>
                            <dd>@_employee.EmployeeCode</dd>
                        </div>
                        <div>
                            <dt>Họ và tên</dt>
                            <dd>@_employee.FullName</dd>
                        </div>
                        <div>
                            <dt>Ngày sinh</dt>
                            <dd>@(_employee.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd>
                        </div>
                        <div>
                            <dt>Chức vụ</dt>
                            <dd>@DisplayValue(_employee.Position)</dd>
                        </div>
                        <div>
                            <dt>Ngày vào làm</dt>
                            <dd>@_employee.HireDate.ToString("dd/MM/yyyy")</dd>
                        </div>
                        <div>
                            <dt>Lương cơ bản</dt>
                            <dd>@_employee.BaseSalary.ToString("N0") đ</dd>
                        </div>
                        @if (!_employee.IsActive)
                        {
                            <div>
                                <dt>Ngày bắt đầu nghỉ</dt>
                                <dd>@(_employee.LeaveDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</dd>
                            </div>
                        }
                    </dl>
                </section>

                <section class="employee-detail-section bf-surface-card" aria-labelledby="employee-contact-title">
                    <div class="employee-detail-section-heading">
                        <div>
                            <h2 id="employee-contact-title">Thông tin liên hệ</h2>
                        </div>
                    </div>

                    <dl class="employee-detail-fields">
                        <div>
                            <dt>Số điện thoại</dt>
                            <dd>@DisplayValue(_employee.Phone)</dd>
                        </div>
                        <div>
                            <dt>Email</dt>
                            <dd>@DisplayValue(_employee.Email)</dd>
                        </div>
                        <div class="employee-detail-field-wide">
                            <dt>Địa chỉ</dt>
                            <dd>@DisplayValue(_employee.Address)</dd>
                        </div>
                    </dl>
                </section>
            </div>
        </div>

        <section class="employee-detail-history bf-surface-card" aria-labelledby="employee-history-title">
            <div class="employee-detail-section-heading">
                <div>
                    <h2 id="employee-history-title">Lịch sử chi nhánh</h2>
                </div>
                <span class="employee-detail-history-count">@_employee.BranchHistory.Count lần phân công</span>
            </div>

            @if (_employee.BranchHistory.Count == 0)
            {
                <div class="employee-detail-history-empty" role="status">
                    Nhân viên chưa có lịch sử chi nhánh.
                </div>
            }
            else
            {
                <ol class="employee-detail-timeline">
                    @foreach (EmployeeBranchHistoryDTO history in _employee.BranchHistory)
                    {
                        <li class="employee-detail-timeline-item" @key="history">
                            <span class="employee-detail-timeline-dot" aria-hidden="true"></span>
                            <div class="employee-detail-timeline-body">
                                <div class="employee-detail-timeline-heading">
                                    <h3>@history.BranchName</h3>
                                    @if (history.ActiveTo is null)
                                    {
                                        <span class="employee-detail-current">Hiện tại</span>
                                    }
                                </div>
                                <p>
                                    @history.ActiveFrom.ToString("dd/MM/yyyy")
                                    <span aria-hidden="true">–</span>
                                    @(history.ActiveTo?.ToString("dd/MM/yyyy") ?? "Hiện tại")
                                </p>
                            </div>
                        </li>
                    }
                </ol>
            }
        </section>
    }
</div>

@code {
    [Parameter]
    public int EmployeeId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "branchId")]
    public int BranchId { get; set; }

    private EmployeeDetailDTO? _employee;
    private bool _isLoading = true;
    private string? _errorMessage;

    // LocalStorage chỉ sẵn sàng sau lần render đầu tiên.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadEmployeeAsync();
        StateHasChanged();
    }

    // Đọc hồ sơ qua API theo cả employeeId và branchId để giữ phạm vi chi nhánh.
    private async Task LoadEmployeeAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            if (EmployeeId <= 0 || BranchId <= 0)
            {
                _errorMessage = "EmployeeId và BranchId phải lớn hơn 0.";
                return;
            }

            EmployeeDetailDTO? employee =
                await EmployeeApiService.GetEmployeeDetailAsync(EmployeeId, BranchId);

            if (employee is null)
            {
                _errorMessage = "Không thể tải hồ sơ nhân viên.";
                return;
            }

            _employee = employee;
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Không thể kết nối đến API.";
        }
        catch (JSException)
        {
            _errorMessage = "Không thể đọc token đăng nhập.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Thống nhất cách hiển thị những trường chưa có dữ liệu.
    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Chưa cập nhật" : value;
    }

    // Dùng ký tự tên thay cho ảnh đại diện nếu hồ sơ chưa có ảnh.
    private static string GetEmployeeInitial(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return "NV";
        }

        string[] nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (nameParts.Length == 1)
        {
            return nameParts[0][0].ToString().ToUpperInvariant();
        }

        string firstInitial = nameParts[0][0].ToString();
        string lastInitial = nameParts[nameParts.Length - 1][0].ToString();

        return (firstInitial + lastInitial).ToUpperInvariant();
    }
}
