@page "/my-orders/{OrderId:int}"

@using System.Text.Json
@using TuanKietBranchFlow.Application.DTOs.Orders
@using TuanKietBranchFlow.Web.Models
@using TuanKietBranchFlow.Web.Services

@inject OrderApiService OrderApiService

<PageTitle>Chi tiết đơn</PageTitle>
<div class="my-order-detail-page bf-page">
    @if (_isLoading)
    {
        <section class="my-order-detail-state bf-surface" aria-live="polite">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Đang tải chi tiết đơn</span>
            </div>

            <h1 class="h5 mb-0">Đang tải chi tiết đơn</h1>
            <p>Vui lòng chờ trong giây lát.</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="my-order-detail-state my-order-detail-state-error bf-surface" role="alert">
            <h1 class="h5 mb-0">Không thể tải đơn hàng</h1>
            <p>@_errorMessage</p>

            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a href="/my-orders" class="btn btn-outline-secondary">
                    Quay lại danh sách
                </a>

                <button type="button" class="btn btn-danger" @onclick="LoadOrderAsync">
                    Thử lại
                </button>
            </div>
        </section>
    }
    else if (_order is null)
    {
        <section class="my-order-detail-state bf-surface" role="status">
            <h1 class="h5 mb-0">Không có dữ liệu chi tiết</h1>
            <p>Đơn hàng này chưa có dữ liệu để hiển thị.</p>

            <a href="/my-orders" class="btn btn-primary">
                Quay lại danh sách
            </a>
        </section>
    }
    else
    {
        <header class="my-order-detail-hero">
            <div class="my-order-detail-hero-main">
                <a href="/my-orders" class="my-order-detail-back-button" aria-label="Quay lại danh sách đơn">
                    <span aria-hidden="true">←</span>
                </a>

                <div class="my-order-detail-hero-copy">
                    <p class="my-order-detail-eyebrow">Chi tiết đơn</p>
                    <h1>@_order.Code</h1>
                    <p>@_order.BranchName</p>
                </div>
            </div>

            <div class="my-order-detail-hero-summary">
                <span class="my-order-detail-status badge @(GetStatusClass(_order.Status))">
                    @GetStatusText(_order.Status)
                </span>

            </div>
        </header>

        <div class="my-order-detail-content">
            <section class="my-order-detail-information bf-surface" aria-labelledby="order-information-title">
                <div class="my-order-detail-section-heading">
                    <div>
                        <h2 id="order-information-title">Thông tin đơn</h2>
                    </div>
                </div>

                <dl class="my-order-detail-description-list">
                    <div>
                        <dt>Ngày nghiệp vụ</dt>
                        <dd>
                            <time datetime="@_order.BusinessDate.ToString("yyyy-MM-dd")">
                                @_order.BusinessDate.ToString("dd/MM/yyyy")
                            </time>
                        </dd>
                    </div>

                    <div>
                        <dt>Thời gian tạo</dt>
                        <dd>
                            <time datetime="@_order.CreatedAt.ToString("O")">
                                @_order.CreatedAt.ToString("dd/MM/yyyy - HH:mm")
                            </time>
                        </dd>
                    </div>

                    <div>
                        <dt>Chi nhánh</dt>
                        <dd>@_order.BranchCode - @_order.BranchName</dd>
                    </div>
                </dl>
            </section>

            <section class="my-order-detail-items" aria-labelledby="order-items-title">
                <div class="my-order-detail-items-heading">
                    <div>
                        <h2 id="order-items-title">Các món đã đặt</h2>
                    </div>

                    <span>@_order.Items.Count dòng món</span>
                </div>

                @if (_order.Items.Count == 0)
                {
                    <div class="my-order-detail-empty bf-surface" role="status">
                        <p class="mb-0">Đơn hàng không có thông tin món.</p>
                    </div>
                }
                else
                {
                    <div class="my-order-detail-item-list">
                        @foreach (MyOrderDetailItemDTO item in _order.Items)
                        {
                            <article class="my-order-detail-item-card">
                                <header class="my-order-detail-item-header">
                                    <div>
                                        <h3>@item.ProductName</h3>

                                        <div class="my-order-detail-item-meta">
                                            <span>Size @item.SizeName</span>
                                            <span>Số lượng @item.Quantity</span>
                                        </div>
                                    </div>

                                    <strong>@item.SubtotalAmount.ToString("N0") đ</strong>
                                </header>

                                <div class="my-order-detail-item-body">
                                    <div class="my-order-detail-price-row">
                                        <span>Giá size</span>
                                        <strong>@item.UnitPrice.ToString("N0") đ</strong>
                                    </div>

                                    @if (item.Toppings.Count > 0)
                                    {
                                        <section class="my-order-detail-option-group" aria-label="Topping đã chọn">
                                            <h4>Topping</h4>

                                            @foreach (MyOrderDetailToppingDTO topping in item.Toppings)
                                            {
                                                <div class="my-order-detail-price-row">
                                                    <span>@topping.Name × @topping.Quantity</span>
                                                    <strong>
                                                        @((topping.UnitPrice * topping.Quantity).ToString("N0")) đ
                                                    </strong>
                                                </div>
                                            }
                                        </section>
                                    }

                                    @if (item.Notes.Count > 0)
                                    {
                                        <section class="my-order-detail-option-group" aria-label="Ghi chú đã chọn">
                                            <h4>Ghi chú</h4>

                                            <div class="my-order-detail-note-list">
                                                @foreach (MyOrderDetailNoteDTO note in item.Notes)
                                                {
                                                    <span>@note.Name</span>
                                                }
                                            </div>
                                        </section>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            <aside class="my-order-detail-action">
                <section class="my-order-detail-total bf-surface" aria-label="Tổng tiền đơn hàng">
                    <div>
                        <span>Tổng cộng</span>
                    </div>

                    <strong>@_order.TotalAmount.ToString("N0") đ</strong>
                </section>

                @if (string.Equals(
                    _order.Status,
                    "NEEDS_REVIEW",
                    StringComparison.OrdinalIgnoreCase))
                {
                    @if (!string.IsNullOrWhiteSpace(_reportSuccessMessage))
                    {
                        <div class="alert alert-success" role="status">
                            @_reportSuccessMessage
                        </div>
                    }

                    <section class="my-order-detail-review-card" aria-labelledby="reported-order-title">
                        <div>
                            <p class="my-order-detail-section-eyebrow">Đã tiếp nhận</p>
                            <h2 id="reported-order-title">Đơn đang chờ xem lại</h2>
                            <p class="my-order-detail-review-reason">@_order.ReportReason</p>

                            @if (_order.ReportedAt.HasValue)
                            {
                                <small>
                                    Đã báo lúc
                                    <time datetime="@_order.ReportedAt.Value.ToString("O")">
                                        @_order.ReportedAt.Value.ToString("dd/MM/yyyy - HH:mm")
                                    </time>
                                </small>
                            }
                        </div>
                    </section>
                }
                else if (string.Equals(
                    _order.Status,
                    "COMPLETED",
                    StringComparison.OrdinalIgnoreCase))
                {
                    <section class="my-order-detail-report-card bf-surface" aria-labelledby="report-order-title">
                        <div class="my-order-detail-section-heading">
                            <div>
                                <h2 id="report-order-title">Báo sai đơn hàng</h2>
                            </div>
                        </div>

                        <p class="my-order-detail-report-description">
                            Hãy mô tả thông tin chưa chính xác để quản lý kiểm tra.
                        </p>

                        @if (!string.IsNullOrWhiteSpace(_reportErrorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @_reportErrorMessage
                            </div>
                        }

                        <label for="report-reason" class="form-label fw-semibold">
                            Lý do báo sai
                        </label>

                        <textarea id="report-reason"
                                  class="form-control my-order-detail-report-input"
                                  rows="4"
                                  maxlength="500"
                                  placeholder="Ví dụ: Sai size hoặc thiếu topping..."
                                  @bind="_reportReason"
                                  @bind:event="oninput"
                                  disabled="@_isReporting">
                        </textarea>

                        <small class="my-order-detail-character-count">
                            @_reportReason.Length/500 ký tự
                        </small>

                        <button type="button"
                                class="btn btn-outline-danger my-order-detail-report-button"
                                disabled="@(_isReporting || string.IsNullOrWhiteSpace(_reportReason))"
                                @onclick="SubmitReportAsync">
                            @if (_isReporting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                <span>Đang gửi...</span>
                            }
                            else
                            {
                                <span>Gửi báo sai</span>
                            }
                        </button>
                    </section>
                }
            </aside>
        </div>
    }
</div>
@code {
    // ID của đơn được lấy từ URL
    [Parameter]
    public int OrderId { get; set; }

    // Dữ liệu chi tiết đơn hàng từ API
    private MyOrderDetailDTO? _order;

    // Trạng thái tải dữ liệu
    private bool _isLoading = true;
    private string? _errorMessage;

    // Trạng thái form báo sai đơn
    private string _reportReason = string.Empty;
    private bool _isReporting;
    private string? _reportErrorMessage;
    private string? _reportSuccessMessage;

    // LocalStorage chỉ đọc được sau khi trang render lần đầu
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadOrderAsync();

        // OnAfterRenderAsync không tự render lại sau await
        StateHasChanged();
    }

    // Gọi API để tải đơn thuộc employee hiện tại
    private async Task LoadOrderAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            OrderDetailApiResult result =
                await OrderApiService.GetMyOrderDetailAsync(OrderId);

            if (!result.IsSuccess || result.Order is null)
            {
                _errorMessage =
                    result.ErrorMessage ?? "Không thể tải chi tiết đơn.";

                return;
            }

            _order = result.Order;
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Không thể kết nối đến API.";
        }
        catch (JSException)
        {
            _errorMessage = "Không thể đọc token đăng nhập.";
        }
        catch (JsonException)
        {
            _errorMessage = "Dữ liệu API trả về không hợp lệ.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Chuyển mã trạng thái thành nội dung tiếng Việt
    private static string GetStatusText(string status)
    {
        return status switch
        {
            "COMPLETED" => "Hoàn tất",
            "NEEDS_REVIEW" => "Chờ xem lại",
            "ADJUSTED" => "Đã điều chỉnh",
            "CANCELLED" => "Đã hủy",
            _ => status
        };
    }

    // Chọn màu Bootstrap tương ứng với trạng thái
    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "COMPLETED" => "text-bg-success",
            "NEEDS_REVIEW" => "text-bg-warning",
            "ADJUSTED" => "text-bg-info",
            "CANCELLED" => "text-bg-danger",
            _ => "text-bg-secondary"
        };
    }

    // Gửi lý do báo sai đơn và cập nhật trạng thái đơn trên giao diện
    private async Task SubmitReportAsync()
    {
        if (_order is null || _isReporting)
        {
            return;
        }

        string normalizedReason = _reportReason.Trim();

        if (string.IsNullOrWhiteSpace(normalizedReason))
        {
            _reportErrorMessage = "Vui lòng nhập lý do báo sai.";
            return;
        }

        if (normalizedReason.Length > 500)
        {
            _reportErrorMessage = "Lý do báo sai không được vượt quá 500 ký tự.";
            return;
        }

        _isReporting = true;
        _reportErrorMessage = null;
        _reportSuccessMessage = null;

        try
        {
            ReportOrderRequestDTO request =
                new ReportOrderRequestDTO
                {
                    Reason = normalizedReason
                };

            OrderReportApiResult result =
                await OrderApiService.ReportOrderAsync(
                    OrderId,
                    request);

            if (!result.IsSuccess || result.Order is null)
            {
                _reportErrorMessage =
                    result.ErrorMessage
                    ?? "Không thể gửi báo sai đơn hàng.";

                return;
            }

            // Dùng dữ liệu Backend trả về thay vì tự suy đoán
            _order.Status = result.Order.Status;
            _order.ReportReason = result.Order.ReportReason;
            _order.ReportedAt = result.Order.ReportedAt;

            _reportReason = string.Empty;
            _reportSuccessMessage = "Đã gửi đơn cho quản lý xem lại.";
        }
        catch (HttpRequestException)
        {
            _reportErrorMessage = "Không thể kết nối đến API.";
        }
        catch (JSException)
        {
            _reportErrorMessage = "Không thể đọc token đăng nhập.";
        }
        catch (JsonException)
        {
            _reportErrorMessage = "Dữ liệu API trả về không hợp lệ.";
        }
        finally
        {
            _isReporting = false;
        }
    }
}
