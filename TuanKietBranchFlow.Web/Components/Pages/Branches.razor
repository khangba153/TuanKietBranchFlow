@page "/branches"

@using TuanKietBranchFlow.Application.DTOs.Branches
@using TuanKietBranchFlow.Web.Services
@using Microsoft.JSInterop

@inject BranchApiService BranchApiService

<PageTitle>Chi nhánh</PageTitle>

<div class="container-fluid px-0">
    <div class="mb-4">
        <p class="text-success fw-semibold small mb-1">
            HỆ THỐNG
        </p>

        <h1 class="h3 mb-2">
            Chi nhánh
        </h1>

        <p class="text-secondary mb-0">
            Danh sách chi nhánh tài khoản được phép truy cập.
        </p>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex align-items-center gap-2 text-secondary">
            <span class="spinner-border spinner-border-sm" aria-hidden="true">
            </span>

            <span>Đang tải danh sách chi nhánh...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <p class="mb-3">
                @_errorMessage
            </p>

            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="LoadBranchesAsync">
                Thử lại
            </button>
        </div>
    }
    else if (_branches.Count == 0)
    {
        <div class="alert alert-info" role="status">
            Tài khoản chưa có chi nhánh nào để hiển thị.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (AccessibleBranchDTO branch in _branches)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between
                                align-items-start gap-3 mb-3">

                                <div>
                                    <p class="text-secondary small mb-1">
                                        @branch.Code
                                    </p>

                                    <h2 class="h5 mb-0">
                                        @branch.Name
                                    </h2>
                                </div>

                                <span class="badge
                                    @(branch.IsActive
                                            ? "text-bg-success"
                                            : "text-bg-secondary")">

                                    @(branch.IsActive
                                        ? "Đang hoạt động"
                                        : "Ngừng hoạt động")
                                </span>
                            </div>

                            <p class="text-secondary mb-0">
                                @branch.Address
                            </p>
                            <div class="mt-3">
                                <AuthorizeView Roles="OWNER,ADMIN">
                                    <Authorized>
                                        <NavLink class="btn btn-outline-success btn-sm"
                                                 href="@($"/employees?branchId={branch.Id}")">
                                            Xem nhân viên
                                        </NavLink>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    // Chứa danh sách các chi nhánh nhận được từ API
    private List<AccessibleBranchDTO> _branches =
        new List<AccessibleBranchDTO>();

    // Cho biết component đang gọi API
    private bool _isLoading = true;

    // Chứa thông báo khi gọi API thất bại
    private string? _errorMessage;

    // Chí tải dữ liệu sau khi giao diện đã render lần đầu
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Không gọi lại API ở những lần render tiếp theo
        if (!firstRender)
        {
            return;
        }

        await LoadBranchesAsync();

        // Yêu cầu Blazor cập nhật lại giao diện
        StateHasChanged();
    }

    // Gọi API lấy danh sách chi nhánh được phép truy cập
    private async Task LoadBranchesAsync()
    {
        // Bắt đầu request
        _isLoading = true;
        _errorMessage = null;

        try
        {
            List<AccessibleBranchDTO>? branches =
                await BranchApiService.GetAccessibleBranchesAsync();

            // Null có nghĩa là request không thành công
            if (branches == null)
            {
                _errorMessage = "Không thể tải danh sách chi nhánh";

                return;
            }

            // Lưu dữ liệu API vào biến của component
            _branches = branches;
        }
        catch (HttpRequestException)
        {
            // Web không kết nối được đến API
            _errorMessage = "Không thể kết nối đến API.";
        }
        catch (JSException)
        {
            // Không đọc được token từ LocalStorage
            _errorMessage = "Không thể đọc token đăng nhập.";
        }
        finally
        {
            // Request thành công hay thất bại đểu kết thúc loading
            _isLoading = false;
        }
    }
}