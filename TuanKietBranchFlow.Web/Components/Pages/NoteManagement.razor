    // Đọc token và tải dữ liệu sau khi component render
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadNoteGroupsAsync();
            StateHasChanged();
        }

        bool isBusy = HasOpenNoteOperation;
        if (_lastBusyState != isBusy)
        {
            _lastBusyState = isBusy;
            await OnBusyChanged.InvokeAsync(isBusy);
        }
        else if (firstRender)
        {
            // Menu khóa tab khi mới mở component; luôn báo kết quả tải đầu tiên
            await OnBusyChanged.InvokeAsync(isBusy);
        }
    }

