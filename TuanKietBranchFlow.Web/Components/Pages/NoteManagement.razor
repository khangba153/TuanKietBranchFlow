            return;
        }

        _deleteNoteOptionErrorMessage = null;

        MenuNoteGroupDTO? noteGroup =
            _noteGroups.FirstOrDefault(
                group => group.Id == _noteGroupIdForDelete.Value);

        if (noteGroup == null)
        {
            _deleteNoteOptionErrorMessage =
                "Không tìm thấy nhóm chứa lựa chọn ghi chú. Vui lòng tải lại danh sách.";
            return;
        }

        _deletingNoteOptionId = noteOption.Id;

        try
        {
            NoteOptionDeleteApiResult result =
                await NoteOptionApiService.DeleteNoteOptionAsync(noteOption.Id);

            if (!result.IsSuccess)
            {
                _deleteNoteOptionErrorMessage =
                    string.IsNullOrWhiteSpace(result.ErrorMessage)
                    ? "Không thể xóa lựa chọn ghi chú. Vui lòng thử lại."
                    : result.ErrorMessage;

                return;
            }

            // Chỉ bỏ lựa chọn ghi chú khỏi danh sách khi API xác nhận thành công
            noteGroup.NoteOptions.RemoveAll(
                item => item.Id == noteOption.Id);

            _noteGroupIdForDelete = null;
            _noteOptionPendingDelete = null;
        }
        catch (TaskCanceledException)
        {
            _deleteNoteOptionErrorMessage = "Request quá thời gian chờ. Vui lòng tải lại để kiểm tra kết quả trước khi thử lại.";
        }
        catch (HttpRequestException)
        {
            _deleteNoteOptionErrorMessage = "Không thể kết nối đến API.";
        }
        catch (JsonException)
        {
            _deleteNoteOptionErrorMessage =
                "Dữ liệu phản hồi từ API không hợp lệ.";
        }
        finally
        {
            _deletingNoteOptionId = null;
        }
    }
}
