@using System.Text.Json
@using TuanKietBranchFlow.Application.DTOs.MenuManagement
@using TuanKietBranchFlow.Web.Models
@using TuanKietBranchFlow.Web.Services
@inject NoteGroupApiService NoteGroupApiService
@inject NoteOptionApiService NoteOptionApiService

<AuthorizeView Roles="OWNER,ADMIN">
    <Authorized>
        <section class="bf-surface-card overflow-hidden" aria-labelledby="note-group-title">
            <header class="d-flex flex-column flex-sm-row align-items-sm-center
                justify-content-between gap-3 p-3 p-md-4 border-bottom">
                <div>
                    <h2 id="note-group-title" class="h5 mb-1">
                        Nhóm ghi chú và lựa chọn ghi chú
                    </h2>
                    <p class="bf-page-description mb-0">
                        Cấu hình dùng chung; mỗi món chỉ chọn tối đa một lựa chọn trong mỗi nhóm.
                    </p>
                </div>

                <AuthorizeView Roles="ADMIN">
                    <Authorized Context="addGroupAuthorization">
                        <button type="button" class="btn btn-outline-primary align-self-start align-self-sm-auto"
                                @onclick="ShowCreateNoteGroupForm" disabled="@(HasOpenNoteOperation || _isCreateNoteGroupFormVisible
                                || _isCreatingNoteGroup
                                || _editingNoteGroupId.HasValue
                                || _isUpdatingNoteGroup
                                || _noteGroupPendingDelete != null
                                || _deletingNoteGroupId.HasValue
                                || _creatingNoteGroupId.HasValue
                                || _isCreatingNoteOption
                                || _editingNoteOptionId.HasValue
                                || _isUpdatingNoteOption
                                                || _noteOptionPendingDelete != null
                                                || _deletingNoteOptionId.HasValue)">
                            Thêm nhóm
                        </button>
                    </Authorized>
                </AuthorizeView>
            </header>

            <AuthorizeView Roles="ADMIN">
                <Authorized Context="createGroupAuthorization">
                    @if (_isCreateNoteGroupFormVisible)
                    {
                        <section class="p-3 p-md-4 border-bottom bg-body-tertiary"
                                 aria-labelledby="create-note-group-title">
                            <h3 id="create-note-group-title" class="h6 mb-3">
                                Thêm nhóm ghi chú
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(_createNoteGroupErrorMessage))
                            {
                                <div class="alert alert-danger" role="alert">
                                    @_createNoteGroupErrorMessage
                                </div>
                            }

                            <div class="row g-3 align-items-end">
                                <div class="col-12 col-md">
                                    <label for="note-group-name" class="form-label">
                                        Tên nhóm ghi chú
                                    </label>

                                    <input id="note-group-name" type="text" class="form-control" maxlength="100"
                                           placeholder="Ví dụ: Đường" aria-describedby="note-group-name-help"
                                           @bind="_newNoteGroupName" disabled="@_isCreatingNoteGroup" />

                                    <div id="note-group-name-help" class="form-text">
                                        Tên nhóm ghi chú tối đa 100 ký tự.
                                    </div>
                                </div>

                                <div class="col-12 col-md-auto d-flex gap-2">
                                    <button type="button" class="btn btn-outline-secondary"
                                            @onclick="CancelCreateNoteGroup" disabled="@_isCreatingNoteGroup">
                                        Hủy
                                    </button>

                                    <button type="button" class="btn btn-primary" @onclick="CreateNoteGroupAsync"
                                            disabled="@_isCreatingNoteGroup">
                                        @if (_isCreatingNoteGroup)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                            <span>Đang lưu...</span>
                                        }
                                        else
                                        {
                                            <span>Lưu nhóm ghi chú</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </section>
                    }
                </Authorized>
            </AuthorizeView>

            @if (_isLoadingNoteGroups)
            {
                <div class="p-3 p-md-4" role="status">
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    <span>Đang tải nhóm ghi chú...</span>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_noteGroupsErrorMessage))
            {
                <div class="p-3 p-md-4">
                    <div class="alert alert-danger mb-0" role="alert">
                        @_noteGroupsErrorMessage

                        <button type="button" class="btn btn-outline-danger btn-sm ms-2"
                                @onclick="LoadNoteGroupsAsync" disabled="@HasOpenNoteOperation">
                            Thử lại
                        </button>
                    </div>
                </div>
            }
            else if (_noteGroups.Count == 0)
            {
                <div class="p-3 p-md-4">
                    <p class="text-secondary mb-0">
                        Chưa có nhóm ghi chú nào.
                    </p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (MenuNoteGroupDTO noteGroup in _noteGroups)
                    {
                        <article class="list-group-item p-3 p-md-4">
                            <div class="d-flex flex-column flex-lg-row
                                align-items-lg-center gap-3">
                                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                    <h3 class="h6 mb-0">@noteGroup.Name</h3>

                                    @if (noteGroup.IsActive)
                                    {
                                        <span class="badge rounded-pill text-bg-success">
                                            Đang hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill text-bg-secondary">
                                            Tạm ngừng
                                        </span>
                                    }
                                </div>

                                <AuthorizeView Roles="ADMIN">
                                    <Authorized Context="editGroupAuthorization">
                                        <div class="d-flex flex-wrap gap-2">
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm align-self-start align-self-lg-center"
                                                @onclick="() => ShowCreateNoteOptionForm(noteGroup)" disabled="@(HasOpenNoteOperation || _creatingNoteGroupId.HasValue
                                                            || _isCreatingNoteOption
                                                            || _isCreateNoteGroupFormVisible
                                                            || _isCreatingNoteGroup
                                                            || _editingNoteGroupId.HasValue
                                                            || _isUpdatingNoteGroup
                                                            || _noteGroupPendingDelete != null
                                                            || _deletingNoteGroupId.HasValue
                                                            || _editingNoteOptionId.HasValue
                                                            || _isUpdatingNoteOption
                                                || _noteOptionPendingDelete != null
                                                || _deletingNoteOptionId.HasValue)">
                                            Thêm lựa chọn
                                        </button>
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm align-self-start align-self-lg-center"
                                                @onclick="() => StartEditNoteGroup(noteGroup)" disabled="@(HasOpenNoteOperation || _isUpdatingNoteGroup
                                                || _isCreatingNoteGroup
                                                || _noteGroupPendingDelete != null
                                                || _deletingNoteGroupId.HasValue
                                                || _creatingNoteGroupId.HasValue
                                                || _isCreatingNoteOption
                                                || _editingNoteOptionId.HasValue
                                                || _isUpdatingNoteOption
                                                || _noteOptionPendingDelete != null
                                                || _deletingNoteOptionId.HasValue)">
                                            Sửa
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm align-self-start align-self-lg-center"
                                                @onclick="() => RequestNoteGroupDelete(noteGroup)" disabled="@(HasOpenNoteOperation || _noteGroupPendingDelete != null
                                                            || _deletingNoteGroupId.HasValue
                                                            || _isCreatingNoteGroup
                                                            || _isCreateNoteGroupFormVisible
                                                            || _isUpdatingNoteGroup
                                                            || _editingNoteGroupId.HasValue
                                                            || _creatingNoteGroupId.HasValue
                                                            || _isCreatingNoteOption
                                                            || _editingNoteOptionId.HasValue
                                                            || _isUpdatingNoteOption
                                                || _noteOptionPendingDelete != null
                                                || _deletingNoteOptionId.HasValue)">
                                            Xóa
                                        </button>
                                        </div>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                            <div class="mt-3">
                                @if (noteGroup.NoteOptions.Count == 0)
                                {
                                    <p class="small text-secondary mb-0">
                                        Chưa có lựa chọn ghi chú trong nhóm.
                                    </p>
                                }
                                else
                                {
                                    <div class="list-group">
                                        @foreach (MenuNoteOptionDTO noteOption in noteGroup.NoteOptions)
                                        {
                                            <div class="list-group-item">
                                                <div class="d-flex flex-column flex-sm-row
                                                    align-items-sm-center justify-content-between gap-3">
                                                    <div class="fw-semibold">@noteOption.Name</div>



                                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                                        @if (noteOption.IsActive)
                                                        {
                                                            <span class="badge rounded-pill text-bg-success">
                                                                Đang hoạt động
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge rounded-pill text-bg-secondary">
                                                                Tạm ngừng
                                                            </span>
                                                        }

                                                        <AuthorizeView Roles="ADMIN">
                                                            <Authorized Context="noteOptionActionsAuthorization">
                                                                <button type="button" class="btn btn-outline-primary btn-sm"
                                                                        @onclick="() => StartEditNoteOption(noteGroup, noteOption)"
                                                                        disabled="@(HasOpenNoteOperation || _isUpdatingNoteOption
                                                                                    || _isCreatingNoteOption
                                                                                    || _creatingNoteGroupId.HasValue
                                                                                    || _isCreateNoteGroupFormVisible
                                                                                    || _isCreatingNoteGroup
                                                                                    || _editingNoteGroupId.HasValue
                                                                                    || _isUpdatingNoteGroup
                                                                                    || _noteGroupPendingDelete != null
                                                                                    || _deletingNoteGroupId.HasValue)">
                                                                    Sửa
                                                                </button>

                                                                <button type="button" class="btn btn-outline-danger btn-sm"
                                                                        @onclick="() => RequestNoteOptionDelete(noteGroup, noteOption)"
                                                                        disabled="@(HasOpenNoteOperation || _noteOptionPendingDelete != null
                                                                                    || _deletingNoteOptionId.HasValue
                                                                                    || _isCreatingNoteOption
                                                                                    || _creatingNoteGroupId.HasValue
                                                                                    || _isUpdatingNoteOption
                                                                                    || _editingNoteOptionId.HasValue
                                                                                    || _isCreatingNoteGroup
                                                                                    || _isCreateNoteGroupFormVisible
                                                                                    || _isUpdatingNoteGroup
                                                                                    || _editingNoteGroupId.HasValue
                                                                                    || _noteGroupPendingDelete != null
                                                                                    || _deletingNoteGroupId.HasValue)">
                                                                    Xóa
                                                                </button>
                                                            </Authorized>
                                                        </AuthorizeView>
                                                    </div>
                                                </div>
                                                <AuthorizeView Roles="ADMIN">
                                                    <Authorized Context="editNoteOptionFormAuthorization">
                                                        @if (_editingNoteOptionId == noteOption.Id)
                                                        {
                                                            <section class="mt-3 p-3 border rounded bg-body-tertiary"
                                                                     aria-labelledby="@($"edit-noteOption-title-{noteOption.Id}")">
                                                                <h4 id="@($"edit-noteOption-title-{noteOption.Id}")" class="h6 mb-3">
                                                                    Thông tin lựa chọn
                                                                </h4>
                                                                @if (!string.IsNullOrWhiteSpace(_updateNoteOptionErrorMessage))
                                                                {
                                                                    <div class="alert alert-danger" role="alert">
                                                                        @_updateNoteOptionErrorMessage
                                                                    </div>
                                                                }
                                                                <div class="row g-3">
                                                                    <div class="col-12 col-md-7">
                                                                        <label for="@($"edit-noteOption-name-{noteOption.Id}")"
                                                                               class="form-label">Tên lựa chọn</label>
                                                                        <input id="@($"edit-noteOption-name-{noteOption.Id}")"
                                                                               type="text" class="form-control" maxlength="100" @bind="_editedNoteOptionName"
                                                                               disabled="@_isUpdatingNoteOption" />
                                                                    </div>



                                                                    <div class="col-12 col-md-5">
                                                                        <label for="@($"edit-noteOption-status-{noteOption.Id}")"
                                                                               class="form-label">Trạng thái</label>
                                                                        <select id="@($"edit-noteOption-status-{noteOption.Id}")"
                                                                                class="form-select"
                                                                                value="@(_editedNoteOptionIsActive ? "true" : "false")"
                                                                                @onchange="OnEditedNoteOptionStatusChanged"
                                                                                disabled="@_isUpdatingNoteOption">
                                                                            <option value="true">Đang hoạt động</option>
                                                                            <option value="false">Tạm ngừng</option>
                                                                        </select>
                                                                    </div>

                                                                    <div class="col-12 d-flex justify-content-end gap-2">
                                                                        <button type="button" class="btn btn-outline-secondary"
                                                                                @onclick="CancelEditNoteOption" disabled="@_isUpdatingNoteOption">
                                                                            Hủy
                                                                        </button>

                                                                        <button type="button" class="btn btn-primary"
                                                                                @onclick="SaveNoteOptionChangesAsync"
                                                                                disabled="@_isUpdatingNoteOption">
                                                                            @if (_isUpdatingNoteOption)
                                                                            {
                                                                                <span class="spinner-border spinner-border-sm me-2"
                                                                                      aria-hidden="true"></span>
                                                                                <span>Đang lưu...</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span>Lưu thay đổi</span>
                                                                            }
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            </section>
                                                        }
                                                    </Authorized>
                                                </AuthorizeView>

                                                <AuthorizeView Roles="ADMIN">
                                                    <Authorized Context="deleteNoteOptionFormAuthorization">
                                                        @if (_noteOptionPendingDelete?.Id == noteOption.Id
                                                             && _noteGroupIdForDelete == noteGroup.Id)
                                                        {
                                                            <section class="mt-3 p-3 border rounded bg-body-tertiary"
                                                                     aria-labelledby="@($"delete-noteOption-title-{noteOption.Id}")">
                                                                <h4 id="@($"delete-noteOption-title-{noteOption.Id}")"
                                                                    class="h6 mb-2">
                                                                    Xác nhận xóa lựa chọn ghi chú
                                                                </h4>

                                                                <p>
                                                                    Bạn có chắc muốn xóa lựa chọn ghi chú
                                                                    <strong>@noteOption.Name</strong>?
                                                                </p>

                                                                <div class="alert alert-warning" role="alert">
                                                                    Lựa chọn ghi chú sẽ bị ẩn khỏi menu nhân viên.
                                                                    Dữ liệu và lịch sử đơn hàng vẫn được giữ trong database.
                                                                </div>

                                                                @if (!string.IsNullOrWhiteSpace(_deleteNoteOptionErrorMessage))
                                                                {
                                                                    <div class="alert alert-danger" role="alert">
                                                                        @_deleteNoteOptionErrorMessage
                                                                    </div>
                                                                }

                                                                <div class="d-flex flex-column flex-sm-row
                                                                    justify-content-sm-end gap-2">
                                                                    <button type="button"
                                                                            class="btn btn-outline-secondary"
                                                                            @onclick="CancelNoteOptionDelete"
                                                                            disabled="@_deletingNoteOptionId.HasValue">
                                                                        Hủy
                                                                    </button>

                                                                    <button type="button"
                                                                            class="btn btn-danger"
                                                                            @onclick="ConfirmNoteOptionDeleteAsync"
                                                                            disabled="@_deletingNoteOptionId.HasValue">
                                                                        @if (_deletingNoteOptionId == noteOption.Id)
                                                                        {
                                                                            <span class="spinner-border spinner-border-sm me-2"
                                                                                  aria-hidden="true"></span>
                                                                            <span>Đang xóa...</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span>Xác nhận xóa</span>
                                                                        }
                                                                    </button>
                                                                </div>
                                                            </section>
                                                        }
                                                    </Authorized>
                                                </AuthorizeView>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <AuthorizeView Roles="ADMIN">
                                <Authorized Context="createNoteOptionFormAuthorization">
                                    @if (_creatingNoteGroupId == noteGroup.Id)
                                    {
                                        <section class="mt-3 p-3 border rounded bg-body-tertiary"
                                                 aria-labelledby="@($"create-noteOption-title-{noteGroup.Id}")">
                                            <h4 id="@($"create-noteOption-title-{noteGroup.Id}")" class="h6 mb-3">
                                                Thêm lựa chọn vào nhóm @noteGroup.Name
                                            </h4>
                                            @if (!string.IsNullOrWhiteSpace(_createNoteOptionErrorMessage))
                                            {
                                                <div class="alert alert-danger" role="alert">
                                                    @_createNoteOptionErrorMessage
                                                </div>
                                            }
                                            <div class="row g-3">
                                                <div class="col-12">
                                                    <label for="@($"new-noteOption-name-{noteGroup.Id}")" class="form-label">
                                                        Tên lựa chọn ghi chú
                                                    </label>

                                                    <input id="@($"new-noteOption-name-{noteGroup.Id}")" type="text"
                                                           class="form-control" maxlength="100" placeholder="Ví dụ: Ít đường"
                                                           @bind="_newNoteOptionName" disabled="@_isCreatingNoteOption" />
                                                </div>



                                                <div class="col-12 d-flex justify-content-end gap-2">
                                                    <button type="button" class="btn btn-outline-secondary"
                                                            @onclick="CancelCreateNoteOption" disabled="@_isCreatingNoteOption">
                                                        Hủy
                                                    </button>

                                                    <button type="button" class="btn btn-primary" @onclick="CreateNoteOptionAsync"
                                                            disabled="@_isCreatingNoteOption">
                                                        @if (_isCreatingNoteOption)
                                                        {
                                                            <span class="spinner-border spinner-border-sm me-2"
                                                                  aria-hidden="true"></span>
                                                            <span>Đang lưu...</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Lưu lựa chọn</span>
                                                        }
                                                    </button>
                                                </div>
                                            </div>
                                        </section>
                                    }
                                </Authorized>
                            </AuthorizeView>
                            <AuthorizeView Roles="ADMIN">
                                <Authorized Context="editGroupFormAuthorization">
                                    @if (_editingNoteGroupId == noteGroup.Id)
                                    {
                                        <section class="mt-3 p-3 border rounded bg-body-tertiary"
                                                 aria-labelledby="@($"edit-note-group-title-{noteGroup.Id}")">
                                            <h4 id="@($"edit-note-group-title-{noteGroup.Id}")" class="h6 mb-3">
                                                Thông tin nhóm ghi chú
                                            </h4>

                                            @if (!string.IsNullOrWhiteSpace(_updateNoteGroupErrorMessage))
                                            {
                                                <div class="alert alert-danger" role="alert">
                                                    @_updateNoteGroupErrorMessage
                                                </div>
                                            }

                                            <div class="row g-3">
                                                <div class="col-12 col-md-7">
                                                    <label for="@($"edit-note-group-name-{noteGroup.Id}")" class="form-label">
                                                        Tên nhóm ghi chú
                                                    </label>

                                                    <input id="@($"edit-note-group-name-{noteGroup.Id}")" type="text"
                                                           class="form-control" maxlength="100" @bind="_editedNoteGroupName"
                                                           disabled="@_isUpdatingNoteGroup" />

                                                </div>

                                                <div class="col-12 col-md-5">
                                                    <label for="@($"edit-note-group-status-{noteGroup.Id}")"
                                                           class="form-label">
                                                        Trạng thái
                                                    </label>

                                                    <select id="@($"edit-note-group-status-{noteGroup.Id}")"
                                                            class="form-select"
                                                            value="@(_editedNoteGroupIsActive ? "true" : "false")"
                                                            @onchange="OnEditedNoteGroupStatusChanged"
                                                            disabled="@_isUpdatingNoteGroup">
                                                        <option value="true">Đang hoạt động</option>
                                                        <option value="false">Tạm ngừng</option>
                                                    </select>
                                                </div>

                                                <div class="col-12 d-flex justify-content-end gap-2">
                                                    <button type="button" class="btn btn-outline-secondary"
                                                            @onclick="CancelEditNoteGroup" disabled="@_isUpdatingNoteGroup">
                                                        Hủy
                                                    </button>

                                                    <button type="button" class="btn btn-primary"
                                                            @onclick="SaveNoteGroupChangesAsync"
                                                            disabled="@(_isUpdatingNoteGroup || _isCreatingNoteGroup)">
                                                        @if (_isUpdatingNoteGroup)
                                                        {
                                                            <span class="spinner-border spinner-border-sm me-2"
                                                                  aria-hidden="true"></span>
                                                            <span>Đang lưu...</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Lưu thay đổi</span>
                                                        }
                                                    </button>
                                                </div>
                                            </div>
                                        </section>
                                    }
                                </Authorized>
                            </AuthorizeView>

                            <AuthorizeView Roles="ADMIN">
                                <Authorized Context="deleteGroupFormAuthorization">
                                    @if (_noteGroupPendingDelete?.Id == noteGroup.Id)
                                    {
                                        <section class="mt-3 p-3 border rounded bg-body-tertiary"
                                                 aria-labelledby="@($"delete-note-group-title-{noteGroup.Id}")">
                                            <h4 id="@($"delete-note-group-title-{noteGroup.Id}")" class="h6 mb-2">
                                                Xác nhận xóa nhóm ghi chú
                                            </h4>

                                            <p>
                                                Bạn có chắc muốn xóa nhóm
                                                <strong>@noteGroup.Name</strong>?
                                            </p>

                                            <div class="alert alert-warning">
                                                Nhóm và các lựa chọn ghi chú thuộc nhóm sẽ bị ẩn khỏi menu nhân viên.
                                                Dữ liệu vẫn được giữ trong database;
                                                trạng thái riêng của lựa chọn ghi chú không thay đổi.
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(_deleteNoteGroupErrorMessage))
                                            {
                                                <div class="alert alert-danger" role="alert">
                                                    @_deleteNoteGroupErrorMessage
                                                </div>
                                            }

                                            <div class="d-flex justify-content-end gap-2">
                                                <button type="button" class="btn btn-outline-secondary"
                                                        @onclick="CancelNoteGroupDelete"
                                                        disabled="@_deletingNoteGroupId.HasValue">
                                                    Hủy
                                                </button>

                                                <button type="button" class="btn btn-danger"
                                                        @onclick="ConfirmNoteGroupDeleteAsync"
                                                        disabled="@_deletingNoteGroupId.HasValue">
                                                    @if (_deletingNoteGroupId == noteGroup.Id)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                                        <span>Đang xóa...</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Xác nhận xóa</span>
                                                    }
                                                </button>
                                            </div>
                                        </section>
                                    }
                                </Authorized>
                            </AuthorizeView>
                        </article>

                    }
                </div>
            }
        </section>
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public EventCallback<bool> OnBusyChanged { get; set; }
    private bool _lastBusyState;

    // Có form hoặc xác nhận đang mở thì không cho chuyển tab hay mở thao tác khác
    private bool HasOpenNoteOperation =>
        _isLoadingNoteGroups || _isCreateNoteGroupFormVisible || _isCreatingNoteGroup
        || _editingNoteGroupId.HasValue || _isUpdatingNoteGroup
        || _noteGroupPendingDelete != null || _deletingNoteGroupId.HasValue
        || _creatingNoteGroupId.HasValue || _isCreatingNoteOption
        || _editingNoteOptionId.HasValue || _isUpdatingNoteOption
        || _noteOptionPendingDelete != null || _deletingNoteOptionId.HasValue;

    // State của danh sách nhóm ghi chú và quá trình tải dữ liệu
    private List<MenuNoteGroupDTO> _noteGroups =
        new List<MenuNoteGroupDTO>();

    private bool _isLoadingNoteGroups = true;
    private string? _noteGroupsErrorMessage;

    // State của form tạo nhóm ghi chú
    private bool _isCreateNoteGroupFormVisible;
    private bool _isCreatingNoteGroup;
    private string _newNoteGroupName = string.Empty;
    private string? _createNoteGroupErrorMessage;

    // State của form sửa nhóm ghi chú
    private int? _editingNoteGroupId;
    private string _editedNoteGroupName = string.Empty;
    private bool _editedNoteGroupIsActive;
    private bool _isUpdatingNoteGroup;
    private string? _updateNoteGroupErrorMessage;

    // State của xác nhận và quá trình xóa nhóm ghi chú
    private MenuNoteGroupDTO? _noteGroupPendingDelete;
    private int? _deletingNoteGroupId;
    private string? _deleteNoteGroupErrorMessage;

