        _deleteNoteGroupErrorMessage = null;
        _deletingNoteGroupId = noteGroup.Id;

        try
        {
            NoteGroupDeleteApiResult result =
                await NoteGroupApiService.DeleteNoteGroupAsync(
                    noteGroup.Id);

