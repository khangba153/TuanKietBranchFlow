                return;
            }

            // Thay đúng nhóm bằng dữ liệu mới từ API, gồm cả lựa chọn ghi chú con
            for (int index = 0; index < _noteGroups.Count; index++)
            {
                if (_noteGroups[index].Id == result.NoteGroup.Id)
