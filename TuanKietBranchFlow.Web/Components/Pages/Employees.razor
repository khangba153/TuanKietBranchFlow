@page "/employees"

@using TuanKietBranchFlow.Application.DTOs.Employees
@using TuanKietBranchFlow.Web.Services
@using Microsoft.JSInterop

@inject EmployeeApiService EmployeeApiService

<PageTitle>Nhân viên</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center
        gap-3 mb-4">
        <AuthorizeView Roles="ADMIN">
            <Authorized>
                <a class="btn btn-success" href="@($"/employees/create?branchId={BranchId}")">
                    <span class="me-1">+</span>
                    Thêm nhân viên
                </a>
            </Authorized>
        </AuthorizeView>
        <div>
            <p class="text-success fw-semibold small mb-1">
                NHÂN SỰ
            </p>

            <h1 class="h3 mb-2">
                Nhân viên
            </h1>

            <p class="text-secondary mb-0">
                Hồ sơ, tài khoản và lịch sử phân công chi nhánh.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body border-bottom">
            <div class="row g-3">
                <div class="col-12 col-md-6 col-lg-5">
                    <label for="employee-keyword" class="form-label">
                        Tìm nhân viên
                    </label>

                    <input id="employee-keyword" type="text" class="form-control"
                           placeholder="Nhập tên hoặc mã nhân viên" @bind="_keyword" @bind:event="oninput"
                           disabled="@_isLoading" />
                </div>

                <div class="col-12 col-md-4 col-lg-3">
                    <label for="employee-status" class="form-label">
                        Trạng thái
                    </label>

                    <select id="employee-status" class="form-select" @bind="_statusFilter" disabled="@_isLoading">

                        <option value="">
                            Tất cả trạng thái
                        </option>

                        <option value="true">
                            Đang làm việc
                        </option>

                        <option value="false">
                            Đã nghỉ việc
                        </option>
                    </select>
                </div>

                <div class="col-12 col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-success w-100" @onclick="SearchEmployeesAsync"
                            disabled="@_isLoading">
                        Tìm kiếm
                    </button>
                </div>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="card-body text-center py-5">
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true">
                </span>

                <span class="text-secondary">
                    Đang tải danh sách nhân viên...
                </span>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="card-body">
                <div class="alert alert-danger mb-0" role="alert">

                    <p class="mb-3">
                        @_errorMessage
                    </p>

                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="LoadEmployeesAsync">
                        Thử lại
                    </button>
                </div>
            </div>
        }
        else if (_employees.Count == 0)
        {
            <div class="card-body">
                <div class="alert alert-info mb-0" role="status">
                    Không tìm thấy nhân viên phù hợp.
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nhân viên</th>
                            <th>Chức vụ</th>
                            <th>Chi nhánh hiện tại</th>
                            <th>Ngày vào làm</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (EmployeeListItemDTO employee in _employees)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        @employee.FullName
                                    </strong>

                                    <div class="text-secondary small">
                                        @employee.EmployeeCode
                                    </div>
                                </td>

                                <td>
                                    @(employee.Position
                                        ?? "Chưa cập nhật")
                                </td>

                                <td>
                                    @employee.BranchName
                                </td>

                                <td>
                                    @employee.HireDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    <span class="badge
                                        @(employee.IsActive
                                                    ? "text-bg-success"
                                                    : "text-bg-secondary")">

                                        @(employee.IsActive
                                            ? "Đang làm việc"
                                            : "Đã nghỉ việc")
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a class="btn btn-outline-success btn-sm"
                                       href="@($"/employees/{employee.Id}?branchId={employee.BranchId}")">
                                        Hồ sơ
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
@code {
    // Nhận branchId từ URL: /employees?branchId=1
    [Parameter]
    [SupplyParameterFromQuery(Name = "branchId")]
    public int BranchId { get; set; }

    // Chứa điều kiện tìm kiếm người dùng
    private string _keyword = string.Empty;

    // Null: tất cả, true: đang làm, false: đã nghỉ
    private string _statusFilter = string.Empty;

    // Chứa danh sách nhân viên nhận từ API
    private List<EmployeeListItemDTO> _employees =
        new List<EmployeeListItemDTO>();

    // Quản lý trạng thái tải dữ liệu và thông báo lỗi
    private bool _isLoading = true;
    private string? _errorMessage;

    // Tải dữ liệu sau khi component render lần đầu
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadEmployeesAsync();

        // OnAfterRenderAsync không tự render lại giao diện
        StateHasChanged();
    }

    // Chuyển giá trị giao diện thành điều kiện gửi xuống API
    private bool? GetIsActiveFilter()
    {
        if (_statusFilter == "true")
        {
            return true;
        }

        if (_statusFilter == "false")
        {
            return false;
        }

        // Chuỗi rỗng nghĩa là không lọc trạng thái
        return null;
    }
    // Gọi API lấy danh sách nhân viên theo điều kiện hiện tại
    private async Task LoadEmployeesAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            // Không gọi API khi chưa có chi nhánh hợp lệ
            if (BranchId <= 0)
            {
                _errorMessage = "Vui lòng chọn chi nhánh trước khi xem nhân viên.";

                return;
            }

            bool? isActive = GetIsActiveFilter();

            List<EmployeeListItemDTO>? employees =
                await EmployeeApiService.GetEmployeesAsync(
                    BranchId,
                    _keyword,
                    isActive);

            // Null thể hiện khi API trả lỗi
            if (employees == null)
            {
                _errorMessage = "Không thể tải danh sách nhân viên.";

                return;
            }

            // Danh sách rỗng vẫn là kết quả thành công
            _employees = employees;
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Không thể kết nối đến API.";
        }
        catch (JSException)
        {
            _errorMessage = "Không thể đọc token đăng nhập.";
        }
        finally
        {
            _isLoading = false;
        }
    }
    // Gọi lại API khi người dùng nhấn nút tìm kiếm
    private async Task SearchEmployeesAsync()
    {
        await LoadEmployeesAsync();
    }

}