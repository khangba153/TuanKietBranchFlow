@using TuanKietBranchFlow.Web.Models.Orders
@using TuanKietBranchFlow.Web.Services.Orders
@page "/my-orders/{OrderId:int}"
@implements IAsyncDisposable
@using System.Text.Json
@using TuanKietBranchFlow.Application.DTOs.Orders
@inject OrderApiService OrderApiService
<PageTitle>
    Chi tiết đơn
</PageTitle>
<div class="my-order-detail-page bf-page">
    @if (_isLoading)
    {
        <section class="my-order-detail-state bf-surface" aria-live="polite">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">
                    Đang tải chi tiết đơn
                </span>
            </div>
            <h1 class="h5 mb-0">
                Đang tải chi tiết đơn
            </h1>
            <p>
                Vui lòng chờ trong giây lát.
            </p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="my-order-detail-state my-order-detail-state-error bf-surface" role="alert">
            <h1 class="h5 mb-0">
                Không thể tải đơn hàng
            </h1>
            <p>
                @_errorMessage
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a href="/my-orders" class="btn btn-outline-secondary">
                    Quay lại danh sách
                </a>
                <button type="button" class="btn btn-danger" @onclick="LoadOrderAsync">
                    Thử lại
                </button>
            </div>
        </section>
    }
    else if (_order is null)
    {
        <section class="my-order-detail-state bf-surface" role="status">
            <h1 class="h5 mb-0">
                Không có dữ liệu chi tiết
            </h1>
            <p>
                Đơn hàng này chưa có dữ liệu để hiển thị.
            </p>
            <a href="/my-orders" class="btn btn-primary">
                Quay lại danh sách
            </a>
        </section>
    }
    else
    {
        <header class="my-order-detail-hero">
            <div class="my-order-detail-hero-main">
                <a href="/my-orders" class="my-order-detail-back-button" aria-label="Quay lại danh sách đơn">
                    Danh sách đơn
                </a>
                <div class="my-order-detail-hero-copy">
                    <p class="my-order-detail-eyebrow">
                        Chi tiết đơn
                    </p>
                    <h1>
                        @_order.Code
                    </h1>
                    <p>
                        @_order.BranchName
                    </p>
                </div>
            </div>
            <div class="my-order-detail-hero-summary">
                <button type="button" class="btn btn-outline-secondary"
                    disabled="@(_isReporting || _isRefreshing)" @onclick="LoadOrderAsync">
                    Tải lại
                </button>
                <span class="my-order-detail-status badge @(GetStatusClass(_order.Status))">
                    @GetStatusText(_order.Status)
                </span>
            </div>
        </header>
        @if (!string.IsNullOrWhiteSpace(_resolutionNotice))
        {
            <div class="alert alert-info" role="status">
                @_resolutionNotice
            </div>
        }
        <p class="small text-body-secondary">
            Kết quả xử lý được kiểm tra lại mỗi 15 giây khi đang mở trang.
        </p>
        @if (!string.IsNullOrWhiteSpace(_refreshErrorMessage))
        {
            <div class="alert alert-warning" role="status">
                @_refreshErrorMessage
            </div>
        }
        <MyOrderResolutionHistory History="_order.History" LatestHistoryId="_order.LatestHistoryId" />
        <div class="my-order-detail-content">
            <section class="my-order-detail-information bf-surface" aria-labelledby="order-information-title">
                <div class="my-order-detail-section-heading">
                    <div>
                        <h2 id="order-information-title">
                            Thông tin đơn
                        </h2>
                    </div>
                </div>
                <dl class="my-order-detail-description-list">
                    <div>
                        <dt>
                            Ngày nghiệp vụ
                        </dt>
                        <dd>
                            <time datetime="@_order.BusinessDate.ToString("yyyy-MM-dd")">
                                @_order.BusinessDate.ToString("dd/MM/yyyy")
                            </time>
                        </dd>
                    </div>
                    <div>
                        <dt>
                            Thời gian tạo
                        </dt>
                        <dd>
                            <time datetime="@_order.CreatedAt.ToString("O")">
                                @_order.CreatedAt.ToString("dd/MM/yyyy - HH:mm")
                            </time>
                        </dd>
                    </div>
                    <div>
                        <dt>
                            Chi nhánh
                        </dt>
                        <dd>
                            @_order.BranchCode - @_order.BranchName
                        </dd>
                    </div>
                </dl>
            </section>
            <section class="my-order-detail-items" aria-labelledby="order-items-title">
                <div class="my-order-detail-items-heading">
                    <div>
                        <h2 id="order-items-title">
                            Các món đã đặt
                        </h2>
                    </div>
                    <span>
                        @_order.Items.Count dòng món
                    </span>
                </div>
                @if (_order.Items.Count == 0)
                {
                    <div class="my-order-detail-empty bf-surface" role="status">
                        <p class="mb-0">
                            Đơn hàng không có thông tin món.
                        </p>
                    </div>
                }
                else
                {
                    <div class="my-order-detail-item-list">
                        @foreach (MyOrderDetailItemDTO item in _order.Items)
                        {
                            <article class="my-order-detail-item-card">
                                <header class="my-order-detail-item-header">
                                    <div>
                                        <h3>
                                            @item.ProductName
                                        </h3>
                                        <div class="my-order-detail-item-meta">
                                            <span>
                                                Size @item.SizeName
                                            </span>
                                            <span>
                                                Số lượng @item.Quantity
                                            </span>
                                        </div>
                                    </div>
                                    <strong>
                                        @item.SubtotalAmount.ToString("N0") đ
                                    </strong>
                                </header>
                                <div class="my-order-detail-item-body">
                                    <div class="my-order-detail-price-row">
                                        <span>
                                            Giá size
                                        </span>
                                        <strong>
                                            @item.UnitPrice.ToString("N0") đ
                                        </strong>
                                    </div>
                                    @if (item.Toppings.Count > 0)
                                    {
                                        <section class="my-order-detail-option-group" aria-label="Topping đã chọn">
                                            <h4>
                                                Topping
                                            </h4>
                                            @foreach (MyOrderDetailToppingDTO topping in item.Toppings)
                                            {
                                                <div class="my-order-detail-price-row">
                                                    <span>
                                                        @topping.Name × @topping.Quantity
                                                    </span>
                                                    <strong>
                                                        @((topping.UnitPrice * topping.Quantity).ToString("N0")) đ
                                                    </strong>
                                                </div>
                                            }
                                        </section>
                                    }
                                    @if (item.Notes.Count > 0)
                                    {
                                        <section class="my-order-detail-option-group" aria-label="Ghi chú đã chọn">
                                            <h4>
                                                Ghi chú
                                            </h4>
                                            <div class="my-order-detail-note-list">
                                                @foreach (MyOrderDetailNoteDTO note in item.Notes)
                                                {
                                                    <span>
                                                        @note.Name
                                                    </span>
                                                }
                                            </div>
                                        </section>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
            <aside class="my-order-detail-action">
                <section class="my-order-detail-total bf-surface" aria-label="Tổng tiền đơn hàng">
                    <div>
                        <span>
                            Tổng cộng
                        </span>
                    </div>
                    <strong>
                        @_order.TotalAmount.ToString("N0") đ
                    </strong>
                </section>
                @if (string.Equals(
                _order.Status,
                "NEEDS_REVIEW",
                StringComparison.OrdinalIgnoreCase))
                {
                    @if (!string.IsNullOrWhiteSpace(_reportSuccessMessage))
                    {
                        <div class="alert alert-success" role="status">
                            @_reportSuccessMessage
                        </div>
                    }
                    <section class="my-order-detail-review-card" aria-labelledby="reported-order-title">
                        <div>
                            <p class="my-order-detail-section-eyebrow">
                                Đã tiếp nhận
                            </p>
                            <h2 id="reported-order-title">
                                Đơn đang chờ xem lại
                            </h2>
                            <p class="my-order-detail-review-reason">
                                @_order.ReportReason
                            </p>
                            @if (_order.ReportedAt.HasValue)
                            {
                                <small>
                                    Đã báo lúc
                                    <time datetime="@_order.ReportedAt.Value.ToString("O")">
                                        @_order.ReportedAt.Value.ToString("dd/MM/yyyy - HH:mm")
                                    </time>
                                </small>
                            }
                        </div>
                    </section>
                }
                else if (_order.Status == "COMPLETED" || _order.Status == "ADJUSTED")
                {
                    <section class="my-order-detail-report-card bf-surface" aria-labelledby="report-order-title">
                        <div class="my-order-detail-section-heading">
                            <div>
                                <h2 id="report-order-title">
                                    @(_order.LatestHistoryId > 0 ? "Báo sai lại" : "Báo sai đơn hàng")
                                </h2>
                            </div>
                        </div>
                        <p class="my-order-detail-report-description">
                            Hãy mô tả thông tin chưa chính xác để quản lý kiểm tra.
                        </p>
                        @if (_order.LatestHistoryId > 0)
                        {
                            <div class="form-check mb-3">
                                <input id="reviewed-resolution" class="form-check-input" type="checkbox"
                                    @bind="_hasReviewedResolution" disabled="@_isReporting" />
                                <label class="form-check-label" for="reviewed-resolution">
                                    Tôi đã xem kết quả xử lý gần nhất, nhưng đơn vẫn còn sai.
                                </label>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_reportErrorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @_reportErrorMessage
                            </div>
                        }
                        <label for="report-reason" class="form-label fw-semibold">
                            Lý do báo sai
                        </label>
                        <textarea id="report-reason"
                            class="form-control my-order-detail-report-input"
                            rows="4"
                            maxlength="500"
                            placeholder="Ví dụ: Sai size hoặc thiếu topping..."
                            @bind="_reportReason"
                            @bind:event="oninput"
                            disabled="@_isReporting">
                        </textarea>
                        <small class="my-order-detail-character-count">
                            @_reportReason.Length/500 ký tự
                        </small>
                        <button type="button"
                            class="btn btn-outline-danger my-order-detail-report-button"
                            disabled="@(_isReporting || _reportMustReload || string.IsNullOrWhiteSpace(_reportReason)
                            || (_order.LatestHistoryId > 0 && !_hasReviewedResolution))"
                            @onclick="SubmitReportAsync">
                            @if (_isReporting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true">
                                </span>
                                <span>
                                    Đang gửi...
                                </span>
                            }
                            else
                            {
                                <span>
                                    @(_order.LatestHistoryId > 0 ? "Gửi báo sai lại" : "Gửi báo sai")
                                </span>
                            }
                        </button>
                    </section>
                }
            </aside>
        </div>
    }
</div>

@code
{
    // ID của đơn được lấy từ URL
    [Parameter]
    public int OrderId { get; set; }

    // Dữ liệu chi tiết đơn hàng từ API
    private MyOrderDetailDTO? _order;
    // Trạng thái tải dữ liệu
    private bool _isLoading = true;
    private string? _errorMessage;
    // Trạng thái form báo sai đơn
    private string _reportReason = string.Empty;
    private bool _isReporting;
    private string? _reportErrorMessage;
    private string? _reportSuccessMessage;
    private bool _hasReviewedResolution;
    private bool _reportMustReload;
    private bool _isRefreshing;
    private string? _resolutionNotice;
    private string? _refreshErrorMessage;
    private int _loadedOrderId;
    private int _readVersion;
    private bool _disposed;
    private Task? _refreshTask;
    private readonly CancellationTokenSource _refreshCancellation = new CancellationTokenSource();
    // Tải lại khi đổi URL đơn; chỉ tạo một vòng kiểm tra cho mỗi component.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && _loadedOrderId == OrderId)
        {
            return;
        }

        if (_isReporting)
        {
            return;
        }

        _loadedOrderId = OrderId;
        _order = null;
        _reportReason = string.Empty;
        _reportErrorMessage = null;
        _reportSuccessMessage = null;
        _resolutionNotice = null;
        await LoadOrderAsync();
        if (!_disposed && _refreshTask is null)
        {
            _refreshTask = RefreshOrderPeriodicallyAsync();
        }

        // OnAfterRenderAsync không tự render lại sau await
        StateHasChanged();
    }

    // Gọi API để tải đơn thuộc employee hiện tại
    private async Task LoadOrderAsync()
    {
        await ReadOrderAsync(false);
    }

    // Làm mới nền không che form hoặc xóa lý do employee đang nhập.
    private async Task ReadOrderAsync(bool isBackground)
    {
        if (_disposed || _isReporting || (isBackground && _isRefreshing))
        {
            return;
        }

        int requestedOrderId = OrderId;
        int readVersion = ++_readVersion;
        _isRefreshing = true;
        if (!isBackground)
        {
            _isLoading = true;
            _errorMessage = null;
        }

        try
        {
            OrderDetailApiResult result = await OrderApiService.GetMyOrderDetailAsync(requestedOrderId);
            if (_disposed || readVersion != _readVersion || requestedOrderId != OrderId)
            {
                return;
            }

            if (!result.IsSuccess || result.Order is null)
            {
                if (isBackground)
                {
                    _refreshErrorMessage = "Chưa cập nhật được kết quả mới. Hãy tải lại trước khi gửi báo sai.";
                }
                else
                {
                    _errorMessage = result.ErrorMessage ?? "Không thể tải chi tiết đơn.";
                }

                return;
            }

            bool hasChanged = _order is null || _order.Id != result.Order.Id || _order.LatestHistoryId != result.Order.LatestHistoryId || _order.Status != result.Order.Status;
            if (hasChanged || !isBackground)
            {
                if (isBackground && _order is not null)
                {
                    _resolutionNotice = "Đơn vừa được cập nhật. Hãy xem trạng thái và kết quả xử lý mới nhất bên dưới.";
                }

                _order = result.Order;
                _hasReviewedResolution = false;
                _reportMustReload = false;
            }

            _refreshErrorMessage = null;
        }
        catch (HttpRequestException)
        {
            SetReadError(isBackground, "Không thể kết nối đến API. Hãy tải lại để kiểm tra kết quả mới nhất.");
        }
        catch (JsonException)
        {
            SetReadError(isBackground, "Dữ liệu API trả về không hợp lệ. Hãy tải lại đơn.");
        }
        catch (OperationCanceledException)
        {
            SetReadError(
                isBackground,
                "Yêu cầu tải đơn hết thời gian chờ. Hãy tải lại để kiểm tra kết quả mới nhất.");
        }
        finally
        {
            _isLoading = false;
            _isRefreshing = false;
        }
    }

    private void SetReadError(
        bool isBackground,
        string message)
    {
        if (_disposed)
        {
            return;
        }

        if (isBackground)
        {
            _refreshErrorMessage = message;
        }
        else
        {
            _errorMessage = message;
        }
    }

    // Kiểm tra nhẹ mỗi 15 giây; dừng khi rời trang, không gửi lại thao tác ghi.
    private async Task RefreshOrderPeriodicallyAsync()
    {
        using PeriodicTimer timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(_refreshCancellation.Token))
            {
                await InvokeAsync(async () =>
                {
                    await ReadOrderAsync(true);
                    if (!_disposed)
                    {
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException)when (_refreshCancellation.IsCancellationRequested)
        {
        // Component đã rời màn hình nên dừng kiểm tra.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _readVersion++;
        _refreshCancellation.Cancel();
        if (_refreshTask is not null)
        {
            await _refreshTask;
        }

        _refreshCancellation.Dispose();
    }

    // Chuyển mã trạng thái thành nội dung tiếng Việt
    private static string GetStatusText(string status)
    {
        return status switch
        {
            "COMPLETED" => "Hoàn tất",
            "NEEDS_REVIEW" => "Chờ xem lại",
            "ADJUSTED" => "Đã điều chỉnh",
            "CANCELLED" => "Đã hủy",
            _ => status
        };
    }

    // Chọn màu Bootstrap tương ứng với trạng thái
    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "COMPLETED" => "text-bg-success",
            "NEEDS_REVIEW" => "text-bg-warning",
            "ADJUSTED" => "text-bg-info",
            "CANCELLED" => "text-bg-danger",
            _ => "text-bg-secondary"
        };
    }

    // Gửi lý do báo sai đơn và cập nhật trạng thái đơn trên giao diện
    private async Task SubmitReportAsync()
    {
        if (_disposed || _order is null || _order.Id != OrderId || _isReporting || _reportMustReload)
        {
            return;
        }

        string normalizedReason = _reportReason.Trim();
        if (_order.LatestHistoryId > 0 && !_hasReviewedResolution)
        {
            _reportErrorMessage = "Vui lòng xem và xác nhận kết quả xử lý gần nhất trước khi báo sai lại.";
            return;
        }

        if (string.IsNullOrWhiteSpace(normalizedReason))
        {
            _reportErrorMessage = "Vui lòng nhập lý do báo sai.";
            return;
        }

        if (normalizedReason.Length > 500)
        {
            _reportErrorMessage = "Lý do báo sai không được vượt quá 500 ký tự.";
            return;
        }

        _isReporting = true;
        _readVersion++;
        _reportErrorMessage = null;
        _reportSuccessMessage = null;
        int requestedOrderId = _order.Id;
        try
        {
            ReportOrderRequestDTO request = new ReportOrderRequestDTO

            {

                Reason = normalizedReason,
                ExpectedHistoryId = _order.LatestHistoryId,
                HasReviewedResolution = _hasReviewedResolution

            };
            OrderReportApiResult result = await OrderApiService.ReportOrderAsync(requestedOrderId, request);
            if (_disposed || requestedOrderId != OrderId)
            {
                return;
            }

            if (!result.IsSuccess || result.Order is null)
            {
                _reportMustReload = result.StatusCode != 400;
                _reportErrorMessage = result.ErrorMessage ?? "Không thể gửi báo sai đơn hàng.";
                return;
            }

            // Dùng dữ liệu Backend trả về thay vì tự suy đoán
            _order.Status = result.Order.Status;
            _order.ReportReason = result.Order.ReportReason;
            _order.ReportedAt = result.Order.ReportedAt;
            _reportReason = string.Empty;
            _hasReviewedResolution = false;
            _reportSuccessMessage = "Đã gửi đơn cho quản lý xem lại.";
        }
        catch (HttpRequestException)
        {
            _reportMustReload = true;
            _reportErrorMessage = "Chưa xác định được kết quả gửi. Hãy tải lại đơn trước khi tiếp tục.";
        }
        catch (JsonException)
        {
            _reportMustReload = true;
            _reportErrorMessage = "Dữ liệu API trả về không hợp lệ.";
        }
        catch (OperationCanceledException)
        {
            _reportMustReload = true;
            _reportErrorMessage = "Yêu cầu gửi hết thời gian chờ. Hãy tải lại đơn để kiểm tra kết quả, không gửi lặp ngay.";
        }
        finally
        {
            _isReporting = false;
        }
    }
}
