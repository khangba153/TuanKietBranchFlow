@page "/my-orders"

@using System.Text.Json
@using TuanKietBranchFlow.Application.DTOs.Orders
@using TuanKietBranchFlow.Web.Services

@inject OrderApiService OrderApiService

<PageTitle>Đơn của tôi</PageTitle>

<div class="my-orders-page bf-page">
    <header class="my-orders-hero">
        <div class="my-orders-hero-main">
            <a href="/order-menu"
               class="my-orders-back-button"
               aria-label="Quay lại trang gọi món">
                <span aria-hidden="true">←</span>
            </a>

            <div>
                <h1>Đơn của tôi</h1>
            </div>
        </div>

    </header>

    <section class="my-orders-filter bf-surface-card"
             aria-labelledby="order-filter-title">
        <div class="my-orders-filter-heading">
            <div>
                <h2 id="order-filter-title">Lọc đơn hàng</h2>
            </div>

            @if (_todayOnly)
            {
                <span class="my-orders-active-filter">Đang xem hôm nay</span>
            }
        </div>

        <div class="my-orders-filter-grid">
            <div class="my-orders-search">
                <label for="order-keyword" class="visually-hidden">
                    Tìm theo mã đơn
                </label>

                <input id="order-keyword"
                       type="search"
                       class="form-control my-orders-search-input"
                       placeholder="Nhập mã đơn..."
                       autocomplete="off"
                       @bind="_keyword"
                       @bind:event="oninput"
                       disabled="@_isLoading" />
            </div>

            <button type="button"
                    class="btn btn-primary my-orders-filter-button"
                    @onclick="SearchOrdersAsync"
                    disabled="@_isLoading">
                Tìm đơn
            </button>

            <button type="button"
                    class="btn @(_todayOnly ? "btn-primary" : "btn-outline-primary") my-orders-filter-button"
                    @onclick="ToggleTodayFilterAsync"
                    disabled="@_isLoading"
                    aria-pressed="@_todayOnly">
                Hôm nay
            </button>
        </div>
    </section>

    @if (_isLoading)
    {
        <section class="my-orders-state bf-surface-card"
                 aria-live="polite"
                 aria-busy="true">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Đang tải danh sách đơn</span>
            </div>

            <strong>Đang tải lịch sử đơn</strong>
            <p>Vui lòng chờ trong giây lát.</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="my-orders-state my-orders-state-error bf-surface-card"
                 role="alert">
            <span class="my-orders-state-icon" aria-hidden="true">!</span>
            <strong>Không thể tải danh sách đơn</strong>
            <p>@_errorMessage</p>

            <button type="button"
                    class="btn btn-outline-danger"
                    @onclick="LoadOrdersAsync">
                Thử lại
            </button>
        </section>
    }
    else if (_orders.Count == 0)
    {
        <section class="my-orders-state bf-surface-card" aria-live="polite">
            <span class="my-orders-state-icon" aria-hidden="true">▤</span>
            <strong>Chưa tìm thấy đơn phù hợp</strong>
            <p>Thử đổi mã đơn hoặc tắt bộ lọc hôm nay.</p>

            <a href="/order-menu" class="btn btn-primary">
                Gọi món cho khách
            </a>
        </section>
    }
    else
    {
        <section class="my-orders-results" aria-labelledby="order-list-title">
            <div class="my-orders-results-header">
                <div>
                    <h2 id="order-list-title">Danh sách đơn</h2>
                </div>

                <span>@_orders.Count đơn</span>
            </div>

            <div class="my-orders-grid">
                @foreach (MyOrderListItemDTO order in _orders)
                {
                    <article class="my-orders-card">
                        <div class="my-orders-card-header">
                            <div>
                                <span class="my-orders-card-label">Mã đơn</span>
                                <h3>@order.Code</h3>
                            </div>

                            <span class="badge rounded-pill @(GetStatusClass(order.Status))">
                                @GetStatusText(order.Status)
                            </span>
                        </div>

                        <time class="my-orders-created-at"
                              datetime="@order.CreatedAt.ToString("O")">
                            <span aria-hidden="true">◷</span>
                            @order.CreatedAt.ToString("dd/MM/yyyy · HH:mm")
                        </time>

                        <div class="my-orders-card-metrics">
                            <div>
                                <span>Số lượng</span>
                                <strong>@order.TotalQuantity món</strong>
                            </div>

                            <div class="text-end">
                                <span>Tổng tiền</span>
                                <strong class="my-orders-total">
                                    @order.TotalAmount.ToString("N0") đ
                                </strong>
                            </div>
                        </div>

                        <a href="@($"/my-orders/{order.Id}")"
                           class="my-orders-detail-link"
                           aria-label="Xem chi tiết đơn @order.Code">
                            <span>Xem chi tiết</span>
                            <span aria-hidden="true">→</span>
                        </a>
                    </article>
                }
            </div>
        </section>
    }
</div>

@code {
    // Danh sách đơn nhận từ API
    private List<MyOrderListItemDTO> _orders =
        new List<MyOrderListItemDTO>();

    // Điều kiện lọc trên giao diện
    private string _keyword = string.Empty;
    private bool _todayOnly;

    // Trạng thái tải dữ liệu
    private bool _isLoading = true;
    private string? _errorMessage;

    // LocalStorage chỉ đọc được sau khi trang render lần đầu
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadOrdersAsync();

        // OnAfterRenderAsync không tự render lại sau await
        StateHasChanged();
    }

    // Gọi API theo từ khóa và bộ lọc ngày hiện tại
    private async Task LoadOrdersAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            DateOnly? businessDate = null;

            if (_todayOnly)
            {
                businessDate = DateOnly.FromDateTime(DateTime.Today);
            }

            List<MyOrderListItemDTO>? orders =
                await OrderApiService.GetMyOrdersAsync(
                    _keyword,
                    businessDate);

            if (orders is null)
            {
                _errorMessage = "Không thể tải danh sách đơn.";
                return;
            }

            _orders = orders;
        }
        catch (HttpRequestException)
        {
            _errorMessage = "Không thể kết nối đến API.";
        }
        catch (JSException)
        {
            _errorMessage = "Không thể đọc token đăng nhập.";
        }
        catch (JsonException)
        {
            _errorMessage = "Dữ liệu API trả về không hợp lệ.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Tải danh sách theo mã đơn đang nhập
    private async Task SearchOrdersAsync()
    {
        await LoadOrdersAsync();
    }

    // Bật hoặc tắt điều kiện chỉ xem đơn hôm nay
    private async Task ToggleTodayFilterAsync()
    {
        _todayOnly = !_todayOnly;

        await LoadOrdersAsync();
    }

    // Chuyển mã trạng thái thành nội dung Tiếng Việt
    private static string GetStatusText(string status)
    {
        return status switch
        {
            "COMPLETED" => "Hoàn tất",
            "NEEDS_REVIEW" => "Chờ xem lại",
            "ADJUSTED" => "Đã điều chỉnh",
            "CANCELLED" => "Đã hủy",
            _ => status
        };
    }

    // Chọn màu Bootstrap tương ứng với trạng thái
    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "COMPLETED" => "text-bg-success",
            "NEEDS_REVIEW" => "text-bg-warning",
            "ADJUSTED" => "text-bg-info",
            "CANCELLED" => "text-bg-danger",
            _ => "text-bg-secondary"
        };
    }
}
